[Unit]
Description=Persistent Nix store bind mount
DefaultDependencies=no
Requires=nix-storage-setup.service
After=nix-storage-setup.service
Before=rocknix-guest.service rocknix-guest-promote.service

[Mount]
What=/storage/.nix-root
Where=/nix
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
