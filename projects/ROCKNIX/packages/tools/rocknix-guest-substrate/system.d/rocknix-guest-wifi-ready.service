[Unit]
Description=Ensure SM8550 guest Wi-Fi is unblocked and enabled
RequiresMountsFor=/storage
After=rocknix-guest.service
Before=rocknix-guest-promote.service
ConditionPathExists=/dev/rfkill

[Service]
Type=oneshot
ExecStart=/usr/bin/rocknix-guest-wifi-unblock --guest-radio
TimeoutStartSec=3min
RemainAfterExit=yes

[Install]
WantedBy=rocknix-main-space.target
