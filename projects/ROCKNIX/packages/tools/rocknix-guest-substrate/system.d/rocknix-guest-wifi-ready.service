[Unit]
Description=Ensure SM8550 guest Wi-Fi is unblocked and enabled
Requires=rocknix-guest-root-ensure.service
After=rocknix-guest-root-ensure.service rocknix-guest.service
Before=rocknix-guest-promote.service
RequiresMountsFor=/storage /flash
ConditionKernelCommandLine=!rocknix.safe=1
ConditionPathExists=!/flash/rocknix.no-nspawn
ConditionPathExists=/dev/rfkill

[Service]
Type=oneshot
ExecStart=/usr/bin/rocknix-guest-wifi-unblock --guest-radio
TimeoutStartSec=3min
RemainAfterExit=yes

[Install]
WantedBy=rocknix-main-space.target
