#
# Main-space target. This is default.target on SM8550 builds. It Wants
# the guest unit and does NOT Want the legacy host
# sway/essway/pipewire/wireplumber/bluetooth/inputplumber stack -- those
# are not part of the thin-host product path; SSH-first recovery uses
# multi-user.target.

[Unit]
Description=ROCKNIX main-space (SM8550 guest)
Documentation=file:///usr/lib/rocknix-guest-substrate/docs/layer14-main-space-contract.md
Requires=multi-user.target
After=multi-user.target network-online.target
Wants=rocknix-guest-root-ensure.service rocknix-guest.service
AllowIsolate=yes

[Install]
Alias=default.target
