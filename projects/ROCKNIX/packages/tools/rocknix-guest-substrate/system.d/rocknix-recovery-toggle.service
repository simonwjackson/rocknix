#
# Per-boot recovery audit.
#
# Early target selection is owned by libreelec-target-generator. This oneshot
# runs before sysinit.target only to leave an obvious journal/console breadcrumb
# for the same two toggles (OR semantics):
#   1) /flash/rocknix.no-nspawn flag file (sticky -- survives reboots
#      until manually rm'd; clearable from a card reader on another
#      machine without booting Thor)
#   2) rocknix.safe=1 on the kernel cmdline (per-boot only; clearable
#      by a normal reboot without touching /flash)
#
# Either toggle present -> generator should boot to multi-user.target
# (SSH-first host recovery plane). Both absent -> generator should boot to
# rocknix-main-space.target (NixOS guest main-space). This unit must not call
# systemctl set-default during boot; late persistent default mutation is not a
# same-boot selector.

[Unit]
Description=ROCKNIX recovery audit (early generator selects default.target)
Documentation=file:///flash/HOW-TO-FALL-BACK.md
DefaultDependencies=no
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

# Run on every boot. The conditions inside the script decide the action;
# we cannot use ConditionPathExists here because we want to run when the
# flag is ABSENT too (to flip back to rocknix-main-space.target after a
# user rm'd the flag).

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/rocknix-recovery-toggle
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=sysinit.target
