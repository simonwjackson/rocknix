# Shared SM8550 Nix-on-ROCK storage contract. This file is sourced by host
# substrate helpers; keep it POSIX sh and side-effect free.

# If callers provide the legacy/root override, derive the rest of the contract
# around that override so existing tests and diagnostics can still sandbox the
# helpers without writing to real /storage.
if [ -n "${ROCKNIX_GUEST_ROOT:-}" ] && [ -z "${ROCKNIX_NIX_ON_ROCK_ROOT:-}" ]; then
  NIX_ON_ROCK_CURRENT_ROOT="${ROCKNIX_GUEST_ROOT}"
  NIX_ON_ROCK_ROOTFS_DIR="${ROCKNIX_NIX_ON_ROCK_ROOTFS_DIR:-$(dirname "${NIX_ON_ROCK_CURRENT_ROOT}")}"
  NIX_ON_ROCK_ROOT="${ROCKNIX_NIX_ON_ROCK_ROOT:-$(dirname "${NIX_ON_ROCK_ROOTFS_DIR}")}"
else
  NIX_ON_ROCK_ROOT="${ROCKNIX_NIX_ON_ROCK_ROOT:-/storage/nix-on-rock}"
  NIX_ON_ROCK_ROOTFS_DIR="${ROCKNIX_NIX_ON_ROCK_ROOTFS_DIR:-${NIX_ON_ROCK_ROOT}/rootfs}"
  NIX_ON_ROCK_CURRENT_ROOT="${ROCKNIX_GUEST_ROOT:-${NIX_ON_ROCK_ROOTFS_DIR}/current}"
fi

NIX_ON_ROCK_PREVIOUS_ROOT="${ROCKNIX_GUEST_PREVIOUS_ROOT:-${NIX_ON_ROCK_ROOTFS_DIR}/previous}"
NIX_ON_ROCK_IMAGES_DIR="${ROCKNIX_NIX_ON_ROCK_IMAGES_DIR:-${NIX_ON_ROCK_ROOT}/images}"
NIX_ON_ROCK_SEED_DIR="${ROCKNIX_GUEST_ROOTFS_SEED_DIR:-${NIX_ON_ROCK_IMAGES_DIR}/seeds}"
NIX_ON_ROCK_REQUESTS_DIR="${ROCKNIX_NIX_ON_ROCK_REQUESTS_DIR:-${NIX_ON_ROCK_ROOT}/requests}"
NIX_ON_ROCK_STATE_DIR="${ROCKNIX_NIX_ON_ROCK_STATE_DIR:-${NIX_ON_ROCK_ROOT}/state}"
NIX_ON_ROCK_STAGING_DIR="${ROCKNIX_NIX_ON_ROCK_STAGING_DIR:-${NIX_ON_ROCK_ROOT}/staging}"
NIX_ON_ROCK_GUEST_EXCHANGE_DIR="${ROCKNIX_GUEST_AREA:-${NIX_ON_ROCK_STAGING_DIR}/guest-exchange}"
NIX_ON_ROCK_GUEST_EXCHANGE_GUEST_PATH="${ROCKNIX_GUEST_AREA_GUEST_PATH:-/storage/.guest}"

NIX_ON_ROCK_MANUAL_HOLD_FILE="${ROCKNIX_GUEST_MANUAL_HOLD_FILE:-${NIX_ON_ROCK_REQUESTS_DIR}/manual-generation-hold}"
NIX_ON_ROCK_SWITCH_STATE_FILE="${ROCKNIX_GUEST_SWITCH_STATE:-${NIX_ON_ROCK_STATE_DIR}/generation-switch-a}"
NIX_ON_ROCK_IMPORT_PROVENANCE_FILE="${ROCKNIX_GUEST_IMPORT_PROVENANCE:-${NIX_ON_ROCK_STAGING_DIR}/generation-import-candidate}"
NIX_ON_ROCK_STAGED_SOURCE="${ROCKNIX_GUEST_STAGED_SOURCE:-${NIX_ON_ROCK_GUEST_EXCHANGE_DIR}/rocknix-nix-guest-packaged}"
NIX_ON_ROCK_PROMOTE_SYSTEM_PATH_FILE="${ROCKNIX_GUEST_PROMOTE_SYSTEM_PATH:-${NIX_ON_ROCK_GUEST_EXCHANGE_DIR}/rocknix-guest-promote-system-path}"

NIX_ON_ROCK_LAYOUT_VERSION_FILE="${ROCKNIX_NIX_ON_ROCK_LAYOUT_VERSION_FILE:-${NIX_ON_ROCK_STATE_DIR}/layout-version}"
NIX_ON_ROCK_MIGRATION_IN_PROGRESS="${ROCKNIX_NIX_ON_ROCK_MIGRATION_IN_PROGRESS:-${NIX_ON_ROCK_STAGING_DIR}/layout-migration-in-progress}"

# Legacy paths accepted as migration inputs only.
NIX_ON_ROCK_LEGACY_ROOT="${ROCKNIX_GUEST_LEGACY_ROOT:-/storage/machines/rocknix-guest}"
NIX_ON_ROCK_LEGACY_PREVIOUS_ROOT="${ROCKNIX_GUEST_LEGACY_PREVIOUS_ROOT:-${NIX_ON_ROCK_LEGACY_ROOT}.previous}"
NIX_ON_ROCK_LEGACY_AREA="${ROCKNIX_GUEST_LEGACY_AREA:-/storage/.guest}"
