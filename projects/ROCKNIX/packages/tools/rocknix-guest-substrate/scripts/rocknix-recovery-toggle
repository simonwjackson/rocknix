#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
#
# SM8550 guest recovery audit helper. Boot selection is owned by the early
# systemd target generator, not by late default-target mutation during sysinit.
# Recovery inputs are /flash/rocknix.no-nspawn and rocknix.safe=1.
# This script remains as an on-device journal/console breadcrumb for
# the same recovery inputs.

set -u

FLAG_FILE="${ROCKNIX_RECOVERY_FLAG_FILE:-/flash/rocknix.no-nspawn}"
CMDLINE_FILE="${ROCKNIX_RECOVERY_CMDLINE_FILE:-/proc/cmdline}"
NORMAL_TARGET="rocknix-main-space.target"
RECOVERY_TARGET="multi-user.target"
LOG_TAG="rocknix-recovery-toggle"

ts() {
  date -u +%FT%TZ
}

log() {
  printf '%s %s: %s\n' "$(ts)" "${LOG_TAG}" "$*"
}

mode="normal"
reasons=""

if [ -f "${FLAG_FILE}" ]; then
  mode="recovery"
  reasons="${reasons} flag-file"
fi

if [ -r "${CMDLINE_FILE}" ] && grep -qE '(^| )rocknix\.safe=1( |$)' "${CMDLINE_FILE}"; then
  mode="recovery"
  reasons="${reasons} kernel-cmdline"
fi

if [ "${mode}" = "recovery" ]; then
  log "recovery mode observed (reasons:${reasons}); early generator should select ${RECOVERY_TARGET} and guest units are guarded"
else
  log "normal mode observed; early generator should select ${NORMAL_TARGET}"
fi

exit 0
