#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
#
# SM8550 guest ExecStartPre helper for rocknix-guest-v2.service.
#
# Tier E3 surfaced that the guest's /run/current-system is NOT seeded on
# cold boot -- /run is tmpfs and does not persist. Without this, the
# guest's `nixos-rebuild`-equivalent path is broken on a fresh boot
# until something runs `nix-env -p ... --set ...` for the first time.
#
# Tier E1 surfaced the DNS-bleed bug under load: the host's resolvconf
# rewrites the guest's /etc/resolv.conf because the experimental
# broad-bind unit bound /etc/resolv.conf from the host. The SM8550 guest
# unit deliberately does not bind /etc/resolv.conf; this prep helper
# also touches an ownership marker file inside the guest rootfs so
# downstream tooling (soak/smoke checks) can verify the guest is the
# sole owner.
#
# This helper is intentionally pure shell: no Nix dependency, no
# /run/current-system dependency. It runs before the guest boots.

set -eu

GUEST_ROOT="${ROCKNIX_GUEST_ROOT:-/storage/machines/rocknix-guest}"
PROFILE_DIR="${GUEST_ROOT}/nix/var/nix/profiles"
SYSTEM_PROFILE="${PROFILE_DIR}/system"
GUEST_RUN_DIR="${GUEST_ROOT}/run"
RESOLV_OWN_MARKER="${GUEST_ROOT}/etc/resolv.conf.guest-owned"
GUEST_AREA="/storage/.guest"
LOG_TAG="rocknix-guest-prep"

log() {
  printf '%s %s\n' "${LOG_TAG}:" "$*"
}

fail() {
  log "FAIL: $*"
  exit 1
}

# Guest rootfs sanity. ConditionPathExists in the unit also covers this,
# but if the rootfs is partially populated we want a clearer failure.
[ -d "${GUEST_ROOT}" ] || fail "guest rootfs missing: ${GUEST_ROOT}"
[ -d "${GUEST_ROOT}/nix" ] || fail "guest /nix missing under ${GUEST_ROOT}"
[ -d "${GUEST_ROOT}/etc" ] || fail "guest /etc missing under ${GUEST_ROOT}"

# Repair stale /init and /sbin/init symlinks. The Layer 10b staging path
# wrote these once, then any subsequent `nixos-rebuild switch` inside the
# guest (or a host-side rebuild that re-staged the system profile) updated
# /nix/var/nix/profiles/system to a NEW store path while leaving /init
# symlinked at the OLD store path. systemd-nspawn --boot then aborts with
# `execv(...) failed: No such file or directory` because the old path no
# longer exists in the guest /nix/store.
#
# Validated on Thor 2026-05-08: prior boot's /init pointed at
# izcw1v5...nixos-system... (host-only), guest /nix/store had
# dlsz2rf...nixos-system... only. Relinking /init to the current
# system profile fixed the boot.
#
# Bug 6 fix (also surfaced 2026-05-08): the early version of this script
# tested `[ -x "${current_system}/init" ]` against the HOST filesystem.
# But the system profile path is absolute under /nix/store -- valid
# inside the guest's /nix/store, not the host's. The check would always
# fail on a clean install and the relink would silently skip. Test
# against `${GUEST_ROOT}${path}` instead.
if [ -L "${SYSTEM_PROFILE}" ]; then
  # Read the symlink target without -f resolution so we get the absolute
  # /nix/store/... path as written, not as the host would resolve it.
  link_target="$(readlink "${SYSTEM_PROFILE}")"
  case "${link_target}" in
    /nix/*)
      desired_system="${link_target}"
      ;;
    *)
      # Indirect symlink (system -> system-N-link -> /nix/store/...).
      # Resolve one level via the profile dir.
      profile_dir="$(dirname "${SYSTEM_PROFILE}")"
      indirect="$(readlink "${profile_dir}/${link_target}" 2>/dev/null || true)"
      desired_system="${indirect}"
      ;;
  esac

  if [ -n "${desired_system}" ] && [ -d "${GUEST_ROOT}${desired_system}" ]; then
    desired="${desired_system}/init"
    for init_path in "${GUEST_ROOT}/init" "${GUEST_ROOT}/sbin/init"; do
      if [ -L "${init_path}" ]; then
        cur="$(readlink "${init_path}")"
        if [ "${cur}" != "${desired}" ]; then
          log "relinking ${init_path}: ${cur} -> ${desired}"
          ln -sfn "${desired}" "${init_path}"
        fi
      fi
    done
  else
    log "WARNING: guest system profile resolves to: ${desired_system:-unresolved}"
    log "  (expected GUEST_ROOT${desired_system} to exist)"
  fi
fi

# Guest writable area on /storage. This is what we bind into the guest
# instead of the whole /storage tree. Create on first boot.
if [ ! -d "${GUEST_AREA}" ]; then
  log "creating guest writable area at ${GUEST_AREA}"
  mkdir -p "${GUEST_AREA}"
  chmod 0755 "${GUEST_AREA}"
fi

# Seed /run/current-system + /run/booted-system. The guest's /run is
# tmpfs (created when systemd-nspawn boots into the guest), so we
# can't write directly into a non-existent path. Instead, we stage the
# expected symlinks into the guest rootfs at /run inside the rootfs --
# systemd's tmpfiles will pick them up at boot if the guest has a
# matching tmpfiles.d entry. As a first-cut, we ensure
# /nix/var/nix/profiles/system is a real path the guest can resolve.
if [ -L "${SYSTEM_PROFILE}" ] || [ -e "${SYSTEM_PROFILE}" ]; then
  log "guest system profile present: $(readlink -f "${SYSTEM_PROFILE}" 2>/dev/null || echo unresolved)"
else
  log "WARNING: guest system profile missing: ${SYSTEM_PROFILE}"
  log "  guest will boot without /run/current-system seeded; nixos-rebuild equivalent will fail until first switch"
fi

# Ownership marker for /etc/resolv.conf. The guest config sets this
# file declaratively; if anything host-side ever clobbers it, the
# marker file lets the soak harness detect the bleed by sampling the
# mtime/checksum.
if [ ! -f "${RESOLV_OWN_MARKER}" ]; then
  log "writing resolv.conf ownership marker"
  printf 'guest-owned: %s\n' "$(date -u +%FT%TZ)" > "${RESOLV_OWN_MARKER}"
fi

log "prep complete"
