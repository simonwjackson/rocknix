#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)

# nixctl: front door for ROCKNIX Nix integration layers.
#
# Layer 4: standard single-user Nix on real /nix.
# Layer 5: persistent Nix profiles for CLI tools.
# Layer 6: managed storage-local user environment activation.
#
# Plans:
# - docs/plans/2026-05-04-001-feat-nix-layer-4-real-store-plan.md
# - docs/plans/2026-05-05-001-feat-nix-layer-5-persistent-profiles-plan.md

set -eu

# ---- Versioning ------------------------------------------------------------
# Pinned to the version that nixos.org/nix/install ships as canonical stable.
# Bump NIX_VERSION_PINNED together with NIX_TARBALL_SHA256_PINNED.
NIX_VERSION_PINNED="2.34.7"
NIX_TARBALL_SHA256_PINNED="f1cee64ae7a02330c6421924c28f597c41813f2214ff108622087d8056378b08"

NIX_VERSION="${NIX_VERSION:-${NIX_VERSION_PINNED}}"
NIX_TARBALL_ARCH="${NIX_TARBALL_ARCH:-aarch64-linux}"
NIX_TARBALL_URL="${NIX_TARBALL_URL:-https://releases.nixos.org/nix/nix-${NIX_VERSION}/nix-${NIX_VERSION}-${NIX_TARBALL_ARCH}.tar.xz}"
NIX_TARBALL_SHA256="${NIX_TARBALL_SHA256:-${NIX_TARBALL_SHA256_PINNED}}"

# ---- Filesystem layout -----------------------------------------------------
NIX_INSTALL_ROOT="${NIX_INSTALL_ROOT:-/nix}"
NIX_DEFAULT_PROFILE_BIN="${NIX_DEFAULT_PROFILE_BIN:-${NIX_INSTALL_ROOT}/var/nix/profiles/default/bin}"
NIX_USER_HOME="${HOME:-/storage}"
NIX_USER_PROFILE_LINK="${NIX_USER_PROFILE_LINK:-${NIX_USER_HOME}/.nix-profile}"
NIX_USER_PROFILE_BIN="${NIX_USER_PROFILE_BIN:-${NIX_USER_PROFILE_LINK}/bin}"
NIX_USER_CONFIG_DIR="${NIX_USER_CONFIG_DIR:-${NIX_USER_HOME}/.config/nix}"
NIX_USER_CONFIG_FILE="${NIX_USER_CONFIG_FILE:-${NIX_USER_CONFIG_DIR}/nix.conf}"
NIX_CACHE_DIR="${NIX_CACHE_DIR:-/storage/.cache/nix-install}"
NIX_LAYER6_STATE_DIR="${NIX_LAYER6_STATE_DIR:-/storage/.config/nix-integration/layer6}"
NIX_LAYER6_BIN_DIR="${NIX_LAYER6_BIN_DIR:-/storage/bin}"
NIX_WRAPPER_DIR="${NIX_WRAPPER_DIR:-/storage/bin}"
NIX_LAYER6_PROFILE_D_DIR="${NIX_LAYER6_PROFILE_D_DIR:-/storage/.config/profile.d}"
NIX_LAYER6_ACTIVATE="${NIX_LAYER6_ACTIVATE:-}"
NIX_LAYER7_APP_NAME="${NIX_LAYER7_APP_NAME:-browser}"
NIX_LAYER7_APP_BIN="${NIX_LAYER7_APP_BIN:-chromium}"
NIX_LAYER7_APP_BIN_PATH="${NIX_LAYER7_APP_BIN_PATH:-}"
NIX_LAYER7_LAUNCHER_NAME="${NIX_LAYER7_LAUNCHER_NAME:-rocknix-layer7-browser}"
NIX_LAYER7_PROFILE_SNIPPET="${NIX_LAYER7_PROFILE_SNIPPET:-999-rocknix-layer7-browser}"
NIX_LAYER7_APP_STATE_DIR="${NIX_LAYER7_APP_STATE_DIR:-${NIX_USER_HOME}/.local/share/nix-apps/layer7/${NIX_LAYER7_APP_NAME}}"
NIX_LAYER7_APP_CONFIG_DIR="${NIX_LAYER7_APP_CONFIG_DIR:-${NIX_USER_HOME}/.config/nix-apps/layer7/${NIX_LAYER7_APP_NAME}}"
NIX_LAYER7_APP_CACHE_DIR="${NIX_LAYER7_APP_CACHE_DIR:-${NIX_USER_HOME}/.cache/nix-apps/layer7/${NIX_LAYER7_APP_NAME}}"
NIX_LAYER8_STATE_DIR="${NIX_LAYER8_STATE_DIR:-/storage/.config/nix-integration/layer8}"
NIX_LAYER8_SYSTEMD_DIR="${NIX_LAYER8_SYSTEMD_DIR:-}"
NIX_DAEMON_BIN="${NIX_DAEMON_BIN:-${NIX_DEFAULT_PROFILE_BIN}/nix-daemon}"
NIX_DAEMON_SERVICE="${NIX_DAEMON_SERVICE:-nix-daemon.service}"
NIX_DAEMON_SOCKET="${NIX_DAEMON_SOCKET:-nix-daemon.socket}"
NIX_DAEMON_SOCKET_PATH="${NIX_DAEMON_SOCKET_PATH:-${NIX_INSTALL_ROOT}/var/nix/daemon-socket/socket}"
NIX_GROUP_FILE="${NIX_GROUP_FILE:-/etc/group}"
NIX_SYSTEMCTL="${NIX_SYSTEMCTL:-systemctl}"
NIX_LAYER9_STATE_DIR="${NIX_LAYER9_STATE_DIR:-/storage/.config/nix-integration/layer9}"
NIX_LAYER9_NSPAWN_BIN="${NIX_LAYER9_NSPAWN_BIN:-/usr/bin/systemd-nspawn}"
NIX_LAYER9_GUEST_ROOT="${NIX_LAYER9_GUEST_ROOT:-/storage/machines/rocknix-guest}"
NIX_LAYER9_SKIP_KERNEL_CHECK="${NIX_LAYER9_SKIP_KERNEL_CHECK:-0}"
NIX_LAYER10_STATE_DIR="${NIX_LAYER10_STATE_DIR:-/storage/.config/nix-integration/layer10}"
NIX_LAYER10_GUEST_ROOT="${NIX_LAYER10_GUEST_ROOT:-/storage/machines/rocknix-guest}"
NIX_LAYER10_NSPAWN_BIN="${NIX_LAYER10_NSPAWN_BIN:-${NIX_LAYER9_NSPAWN_BIN}}"
NIX_LAYER10_UNIT_NAME="${NIX_LAYER10_UNIT_NAME:-rocknix-guest.service}"
NIX_LAYER10_SYSTEMD_DIR="${NIX_LAYER10_SYSTEMD_DIR:-}"
NIX_LAYER10_SKIP_KERNEL_CHECK="${NIX_LAYER10_SKIP_KERNEL_CHECK:-${NIX_LAYER9_SKIP_KERNEL_CHECK}}"
NIX_LAYER10_TIMEOUT="${NIX_LAYER10_TIMEOUT:-45}"
NIX_LAYER10_LOG="${NIX_LAYER10_LOG:-/tmp/nix-integration-layer10-guest.log}"
NIX_LAYER10_CPU_WEIGHT="${NIX_LAYER10_CPU_WEIGHT:-1}"
NIX_LAYER10_IO_WEIGHT="${NIX_LAYER10_IO_WEIGHT:-1}"
NIX_LAYER10_MEMORY_MAX="${NIX_LAYER10_MEMORY_MAX:-1G}"
NIX_LAYER10_TASKS_MAX="${NIX_LAYER10_TASKS_MAX:-512}"
NIX_LAYER10_NIX_BIN="${NIX_LAYER10_NIX_BIN:-${NIX_DEFAULT_PROFILE_BIN}/nix}"
NIX_LAYER10_NIX_STORE_BIN="${NIX_LAYER10_NIX_STORE_BIN:-${NIX_DEFAULT_PROFILE_BIN}/nix-store}"
NIX_LAYER10_BASH_BIN="${NIX_LAYER10_BASH_BIN:-}"
NIX_LAYER11_STATE_DIR="${NIX_LAYER11_STATE_DIR:-/storage/.config/nix-integration/layer11}"
NIX_LAYER11_BIN_DIR="${NIX_LAYER11_BIN_DIR:-/storage/bin}"

# ---- SSL ------------------------------------------------------------------
# Pre-set for the upstream installer so it skips its cacert derivation install
# (the system's CA bundle is fine for talking to cache.nixos.org).
NIX_SSL_CERT_FILE_DEFAULT="${NIX_SSL_CERT_FILE_DEFAULT:-/etc/ssl/certs/ca-certificates.crt}"

# ---- Disk budget -----------------------------------------------------------
# Tarball ~23 MB, embedded store ~700 MB after extraction, +cache for store
# copy. 1 GB is a comfortable floor.
NIX_INSTALL_REQUIRED_MB="${NIX_INSTALL_REQUIRED_MB:-1024}"

# ---- Substituter ----------------------------------------------------------
NIX_SUBSTITUTER="${NIX_SUBSTITUTER:-https://cache.nixos.org/}"
NIX_TRUSTED_PUBLIC_KEY="${NIX_TRUSTED_PUBLIC_KEY:-cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY=}"

usage() {
  cat <<EOF
Usage: ${0##*/} <subcommand> [args]

Front door for ROCKNIX Nix Layer 4 (standard single-user Nix on real /nix).

Subcommands:
  status                 Report installed-or-not, version, sandbox setting,
                         and /nix mount status. Read-only.
  install                Install real Nix into ${NIX_INSTALL_ROOT}.
  upgrade [--version V]  Upgrade to a newer Nix version (default: pinned).
  uninstall [--yes]      Remove real Nix and per-user config; restores the
                         system to the Layer 3 substrate.
  doctor                 Run health checks for Nix integration layers.
  user-env <action>      Manage Layer 6 storage-local user environment files.
                         Actions: status, preflight <bundle>, activate <bundle>,
                         deactivate, rollback.
  daemon <action>        Manage experimental Layer 8 nix-daemon mode.
                         Actions: status, preflight, enable, disable, rollback.
  guest <action>         Manage Layer 10 nspawn guest operations.
                         Actions: status, preflight, init --proof, run <cmd>,
                         shell, start, stop, cleanup [--yes].
  bridge <action>        Manage Layer 11 one-shot guest-backed bridges.
                         Actions: status, preflight <name>, install <name> -- <cmd>,
                         remove <name>.
  help, -h, --help       This message.

Environment overrides (defaults shown):
  NIX_VERSION            ${NIX_VERSION}
  NIX_INSTALL_ROOT       ${NIX_INSTALL_ROOT}
  NIX_USER_CONFIG_DIR    ${NIX_USER_CONFIG_DIR}
  NIX_CACHE_DIR          ${NIX_CACHE_DIR}
  NIX_LAYER6_STATE_DIR   ${NIX_LAYER6_STATE_DIR}
  NIX_LAYER7_APP_BIN     ${NIX_LAYER7_APP_BIN}
  NIX_LAYER7_APP_STATE_DIR ${NIX_LAYER7_APP_STATE_DIR}
  NIX_LAYER8_STATE_DIR   ${NIX_LAYER8_STATE_DIR}
  NIX_LAYER9_STATE_DIR   ${NIX_LAYER9_STATE_DIR}
  NIX_LAYER9_NSPAWN_BIN  ${NIX_LAYER9_NSPAWN_BIN}
  NIX_LAYER9_GUEST_ROOT  ${NIX_LAYER9_GUEST_ROOT}
  NIX_LAYER10_STATE_DIR  ${NIX_LAYER10_STATE_DIR}
  NIX_LAYER10_GUEST_ROOT ${NIX_LAYER10_GUEST_ROOT}
  NIX_LAYER10_UNIT_NAME  ${NIX_LAYER10_UNIT_NAME}
  NIX_LAYER10_TIMEOUT    ${NIX_LAYER10_TIMEOUT}
  NIX_LAYER10_MEMORY_MAX ${NIX_LAYER10_MEMORY_MAX}
  NIX_LAYER11_STATE_DIR  ${NIX_LAYER11_STATE_DIR}
  NIX_LAYER11_BIN_DIR    ${NIX_LAYER11_BIN_DIR}
  NIX_TARBALL_URL        ${NIX_TARBALL_URL}
  NIX_TARBALL_SHA256     ${NIX_TARBALL_SHA256}
  NIX_FORCE              Set to 1 to override safety checks (rare)

After install, profile.d puts ${NIX_USER_PROFILE_BIN} and
${NIX_DEFAULT_PROFILE_BIN} on \$PATH ahead of /storage/bin, so 'nix' and
profile-installed CLI tools resolve to real Nix/profile binaries in any login
shell. Layer 6 user-env activation manages declared storage-local files only;
standard 'nix profile' remains the package install/remove interface. Layer 4
real Nix owns unqualified commands such as nix, nix-store, and nix-daemon.

Recovery: if real Nix breaks, 'nixctl uninstall' removes it cleanly. As a
last resort, 'rm -rf /storage/.nix-root && reboot' restores the Layer 3
substrate; reflashing the image is also under five minutes.
EOF
}

# ---- Helpers ---------------------------------------------------------------
fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

info() {
  echo "==> $*"
}

note() {
  echo "    $*"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

sha256_of() {
  if have sha256sum; then
    sha256sum "$1" | awk '{print $1}'
  elif have openssl; then
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  else
    fail "sha256sum or openssl is required to verify the Nix tarball"
  fi
}

check_arch() {
  if [ "${NIX_SKIP_ARCH_CHECK:-0}" = "1" ]; then
    return 0
  fi
  arch=$(uname -m 2>/dev/null || echo unknown)
  case "${arch}" in
    aarch64|arm64) ;;
    *) fail "this installer expects aarch64 ROCKNIX, but uname -m reports '${arch}' (set NIX_SKIP_ARCH_CHECK=1 to override for testing)" ;;
  esac
}

check_storage() {
  storage_root="/storage"
  [ -d "${storage_root}" ] || fail "storage root missing: ${storage_root}"
  [ -w "${storage_root}" ] || fail "storage root not writable: ${storage_root}"

  available_mb=$(df -m "${storage_root}" | awk 'NR==2 {print $4}')
  case "${available_mb}" in
    ''|*[!0-9]*) fail "could not determine free space for ${storage_root}" ;;
  esac
  if [ "${available_mb}" -lt "${NIX_INSTALL_REQUIRED_MB}" ]; then
    fail "not enough free space on ${storage_root}: ${available_mb}MB available, ${NIX_INSTALL_REQUIRED_MB}MB required"
  fi
}

check_nix_mount() {
  [ -d "${NIX_INSTALL_ROOT}" ] || fail "${NIX_INSTALL_ROOT} does not exist; Layer 3 (nix-storage-setup.service + nix.mount) is a prerequisite"
  if ! awk -v p="${NIX_INSTALL_ROOT}" '$2 == p {found=1} END {exit !found}' /proc/mounts 2>/dev/null; then
    note "${NIX_INSTALL_ROOT} is a regular directory, not a bind mount"
    note "Layer 3 may not be active; install will populate ${NIX_INSTALL_ROOT} on the squashfs root"
    note "This will not survive a reboot. Recommended: enable Layer 3 first."
    if [ "${NIX_FORCE:-}" != "1" ]; then
      fail "refusing to install on non-bind-mounted ${NIX_INSTALL_ROOT}; set NIX_FORCE=1 to override"
    fi
  fi
}

download_tarball() {
  url=$1
  dest=$2
  if have curl; then
    curl -fL --retry 3 --connect-timeout 20 --progress-bar "${url}" -o "${dest}" \
      || fail "download failed: curl exit non-zero for ${url}"
  elif have wget; then
    wget -O "${dest}" "${url}" \
      || fail "download failed: wget exit non-zero for ${url}"
  else
    fail "curl or wget is required to download Nix"
  fi
  [ -s "${dest}" ] || fail "download produced empty/missing file: ${dest}"
}

verify_tarball() {
  file=$1
  actual=$(sha256_of "${file}")
  if [ "${actual}" != "${NIX_TARBALL_SHA256}" ]; then
    rm -f "${file}"
    fail "checksum mismatch for Nix tarball: expected ${NIX_TARBALL_SHA256}, got ${actual}"
  fi
}

write_nix_conf() {
  sandbox_setting=$1  # "true" or "false"
  mkdir -p "${NIX_USER_CONFIG_DIR}"
  chmod 0755 "${NIX_USER_CONFIG_DIR}"
  cat >"${NIX_USER_CONFIG_FILE}" <<EOF
# Generated by nixctl on $(date -u +%Y-%m-%dT%H:%M:%SZ)
# ROCKNIX Nix Layer 4 single-user (root) configuration.
# Re-run nixctl install or edit by hand to adjust.

experimental-features = nix-command flakes
substituters = ${NIX_SUBSTITUTER}
trusted-public-keys = ${NIX_TRUSTED_PUBLIC_KEY}
sandbox = ${sandbox_setting}
build-users-group =
EOF
  chmod 0644 "${NIX_USER_CONFIG_FILE}"
}

probe_sandbox() {
  # Run a small no-op derivation that exercises the sandbox. Returns 0 if the
  # build succeeds with sandbox=true, non-zero otherwise. Output is logged.
  #
  # The system is hardcoded rather than computed via builtins.currentSystem
  # because pure-eval (the default for nix-command + flakes in Nix 2.30+)
  # rejects impure builtins in --expr context. We are an aarch64-linux
  # installer; the system is known.
  probe_log=$1
  "${NIX_BIN}" --extra-experimental-features 'nix-command flakes' \
    build --no-link --print-out-paths --offline \
    --expr 'derivation { name = "sandbox-probe"; system = "aarch64-linux"; builder = "/bin/sh"; args = [ "-c" "echo ok > $out" ]; }' \
    >"${probe_log}" 2>&1
}

# Detect whether real Nix is installed and runnable. Sets NIX_BIN on success.
detect_real_nix() {
  if [ -x "${NIX_DEFAULT_PROFILE_BIN}/nix" ]; then
    NIX_BIN="${NIX_DEFAULT_PROFILE_BIN}/nix"
    return 0
  fi
  return 1
}

cleanup_legacy_portable_wrappers() {
  for wrapper in nix nix-shell nix-run nix-dev-shell nix-portable; do
    path="${NIX_WRAPPER_DIR}/${wrapper}"
    if [ -f "${path}" ] && grep -q 'nix-portable' "${path}" 2>/dev/null; then
      rm -f "${path}"
      note "removed legacy portable wrapper: ${path}"
    fi
  done

  path="${NIX_WRAPPER_DIR}/nix-daemon"
  if [ -f "${path}" ] && grep -q '/storage/bin/nix daemon' "${path}" 2>/dev/null; then
    rm -f "${path}"
    note "removed unsafe legacy portable daemon wrapper: ${path}"
  fi
}

# Read the sandbox setting from nix.conf without invoking nix. Returns the
# value (true|false|relaxed|<unset>) on stdout, or "(no nix.conf)" if the
# file is missing.
read_sandbox_setting() {
  if [ ! -f "${NIX_USER_CONFIG_FILE}" ]; then
    echo "(no nix.conf)"
    return
  fi
  setting=$(awk -F= '
    /^[[:space:]]*sandbox[[:space:]]*=/ {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
      print $2
      found=1
      exit
    }
    END {
      if (!found) print "(default)"
    }
  ' "${NIX_USER_CONFIG_FILE}")
  echo "${setting}"
}

# Print one line describing /nix mount state. Uses /proc/mounts because
# findmnt is not on ROCKNIX.
report_nix_mount() {
  if [ ! -d "${NIX_INSTALL_ROOT}" ]; then
    echo "missing: ${NIX_INSTALL_ROOT} directory does not exist"
    return
  fi
  line=$(awk -v p="${NIX_INSTALL_ROOT}" '$2 == p {print; exit}' /proc/mounts 2>/dev/null || true)
  if [ -z "${line}" ]; then
    echo "not mounted: ${NIX_INSTALL_ROOT} is a regular directory (Layer 3 not active)"
    return
  fi
  echo "mounted: ${line}"
}

canonical_path() {
  path=$1
  if [ -e "${path}" ] || [ -L "${path}" ]; then
    readlink -f "${path}" 2>/dev/null || echo "${path}"
  else
    echo "${path}"
  fi
}

# Report which 'nix' the user's $PATH currently resolves to. This is a
# diagnostic for the profile.d ordering, not authoritative for what's
# installed.
report_path_resolution() {
  if have nix; then
    nix_path=$(command -v nix 2>/dev/null || true)
    case "${nix_path}" in
      ${NIX_DEFAULT_PROFILE_BIN}/nix|${NIX_USER_PROFILE_BIN}/nix)
        echo "real nix (${nix_path})"
        ;;
      /storage/bin/nix)
        echo "stale legacy portable wrapper (${nix_path})"
        ;;
      *)
        echo "other: ${nix_path}"
        ;;
    esac
  else
    echo "no 'nix' on \$PATH"
  fi
}

is_expected_nix_tool_shadow() {
  case "$1" in
    nix|nix-build|nix-channel|nix-collect-garbage|nix-copy-closure|nix-daemon|nix-env|nix-hash|nix-instantiate|nix-prefetch-url|nix-shell|nix-store)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

print_profile_conflicts() {
  if [ ! -d "${NIX_USER_PROFILE_BIN}" ]; then
    echo "  command conflicts: profile bin missing"
    return
  fi

  found=0
  for profile_cmd in "${NIX_USER_PROFILE_BIN}"/*; do
    [ -e "${profile_cmd}" ] || continue
    [ -x "${profile_cmd}" ] || continue
    [ ! -d "${profile_cmd}" ] || continue

    name=${profile_cmd##*/}
    profile_real=$(canonical_path "${profile_cmd}")
    for dir in "${NIX_DEFAULT_PROFILE_BIN}" /storage/bin /usr/bin /usr/sbin; do
      candidate="${dir}/${name}"
      [ "${candidate}" != "${profile_cmd}" ] || continue
      [ -e "${candidate}" ] || continue
      [ -x "${candidate}" ] || continue
      candidate_real=$(canonical_path "${candidate}")
      [ "${candidate_real}" != "${profile_real}" ] || continue
      if [ "${dir}" = "/storage/bin" ] && is_expected_nix_tool_shadow "${name}"; then
        continue
      fi
      if [ "${found}" -eq 0 ]; then
        echo "  command conflicts:"
        found=1
      fi
      echo "    ${name}: ${profile_cmd} shadows ${candidate}"
    done
  done

  if [ "${found}" -eq 0 ]; then
    echo "  command conflicts: none detected"
  fi
}

print_layer5_profile_status() {
  echo "Layer 5 (persistent profile) status"
  echo "-----------------------------------"
  if [ -L "${NIX_USER_PROFILE_LINK}" ]; then
    target=$(readlink "${NIX_USER_PROFILE_LINK}" 2>/dev/null || echo "")
    if [ -e "${NIX_USER_PROFILE_LINK}" ]; then
      echo "  profile:  ${NIX_USER_PROFILE_LINK} -> ${target}"
    else
      echo "  profile:  broken symlink ${NIX_USER_PROFILE_LINK} -> ${target}"
    fi
  elif [ -e "${NIX_USER_PROFILE_LINK}" ]; then
    echo "  profile:  present but not a symlink: ${NIX_USER_PROFILE_LINK}"
  else
    echo "  profile:  missing (Layer 5 depends on Layer 4 install)"
  fi

  if [ -d "${NIX_USER_PROFILE_BIN}" ]; then
    echo "  bin:      ${NIX_USER_PROFILE_BIN}"
  else
    echo "  bin:      missing: ${NIX_USER_PROFILE_BIN}"
  fi

  if detect_real_nix; then
    if profile_list=$("${NIX_BIN}" --extra-experimental-features 'nix-command flakes' profile list --json 2>&1); then
      if [ -n "${profile_list}" ]; then
        echo "  entries:"
        printf '%s\n' "${profile_list}" | sed 's/^/    /'
      else
        echo "  entries:  none"
      fi
    else
      echo "  entries:  failed to query profile: ${profile_list}"
    fi
  else
    echo "  entries:  unavailable until Layer 4 real Nix is installed"
  fi

  print_profile_conflicts
}

layer6_activate_bin() {
  if [ -n "${NIX_LAYER6_ACTIVATE}" ] && [ -x "${NIX_LAYER6_ACTIVATE}" ]; then
    echo "${NIX_LAYER6_ACTIVATE}"
    return 0
  fi
  if have nix-layer-activate; then
    command -v nix-layer-activate
    return 0
  fi
  if [ -x /usr/bin/nix-layer-activate ]; then
    echo /usr/bin/nix-layer-activate
    return 0
  fi
  return 1
}

layer6_state() {
  if [ -f "${NIX_LAYER6_STATE_DIR}/state" ]; then
    awk 'NR==1 {print; exit}' "${NIX_LAYER6_STATE_DIR}/state"
  else
    echo absent
  fi
}

layer6_active() {
  [ "$(layer6_state)" = "active" ]
}

print_layer6_status() {
  echo "Layer 6 (managed user environment) status"
  echo "-----------------------------------------"
  if activate_bin=$(layer6_activate_bin); then
    NIX_LAYER6_STATE_DIR="${NIX_LAYER6_STATE_DIR}" \
    NIX_LAYER6_BIN_DIR="${NIX_LAYER6_BIN_DIR}" \
    NIX_LAYER6_PROFILE_D_DIR="${NIX_LAYER6_PROFILE_D_DIR}" \
      "${activate_bin}" status | sed '1,2d; s/^/  /'
  else
    echo "  unavailable: nix-layer-activate not found"
    echo "  state dir:   ${NIX_LAYER6_STATE_DIR}"
  fi
}

layer6_owns_target() {
  target=$1
  owned="${NIX_LAYER6_STATE_DIR}/owned-files"
  [ -f "${owned}" ] || return 1
  awk -F'|' -v target="${target}" '$1 == target {found=1} END {exit !found}' "${owned}"
}

layer7_launcher_path() {
  echo "${NIX_LAYER6_BIN_DIR}/${NIX_LAYER7_LAUNCHER_NAME}"
}

layer7_profile_snippet_path() {
  echo "${NIX_LAYER6_PROFILE_D_DIR}/${NIX_LAYER7_PROFILE_SNIPPET}"
}

layer7_resolved_app_binary() {
  if [ -n "${NIX_LAYER7_APP_BIN_PATH}" ]; then
    [ -x "${NIX_LAYER7_APP_BIN_PATH}" ] || return 1
    echo "${NIX_LAYER7_APP_BIN_PATH}"
    return 0
  fi
  if [ -x "${NIX_USER_PROFILE_BIN}/${NIX_LAYER7_APP_BIN}" ]; then
    echo "${NIX_USER_PROFILE_BIN}/${NIX_LAYER7_APP_BIN}"
    return 0
  fi
  if have "${NIX_LAYER7_APP_BIN}"; then
    command -v "${NIX_LAYER7_APP_BIN}"
    return 0
  fi
  return 1
}

layer7_binary_is_nix_backed() {
  candidate=$1
  real=$(canonical_path "${candidate}")
  case "${candidate}" in
    ${NIX_USER_PROFILE_BIN}/*) return 0 ;;
  esac
  case "${real}" in
    ${NIX_INSTALL_ROOT}/store/*|/storage/.nix-root/store/*) return 0 ;;
  esac
  return 1
}

layer7_path_safe() {
  case "$1" in
    ${NIX_USER_HOME}/.local/share/nix-apps/layer7/*|${NIX_USER_HOME}/.config/nix-apps/layer7/*|${NIX_USER_HOME}/.cache/nix-apps/layer7/*|/storage/.local/share/nix-apps/layer7/*|/storage/.config/nix-apps/layer7/*|/storage/.cache/nix-apps/layer7/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

systemd_unit_path() {
  unit=$1
  dirs="${NIX_LAYER8_SYSTEMD_DIR} /storage/.config/system.d /usr/lib/systemd/system /etc/systemd/system"
  for dir in ${dirs}; do
    [ -n "${dir}" ] || continue
    if [ -f "${dir}/${unit}" ]; then
      echo "${dir}/${unit}"
      return 0
    fi
  done
  return 1
}

nix_is_mounted() {
  awk -v p="${NIX_INSTALL_ROOT}" '$2 == p {found=1} END {exit !found}' /proc/mounts 2>/dev/null
}

layer8_state() {
  if [ -f "${NIX_LAYER8_STATE_DIR}/state" ]; then
    awk 'NR==1 {print; exit}' "${NIX_LAYER8_STATE_DIR}/state"
  else
    echo inactive
  fi
}

layer8_build_users_group() {
  if [ ! -f "${NIX_USER_CONFIG_FILE}" ]; then
    echo "(no nix.conf)"
    return
  fi
  awk -F= '
    /^[[:space:]]*build-users-group[[:space:]]*=/ {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
      print $2
      found=1
      exit
    }
    END { if (!found) print "(default)" }
  ' "${NIX_USER_CONFIG_FILE}"
}

group_exists() {
  group=$1
  [ -n "${group}" ] || return 1
  if have getent; then
    getent group "${group}" >/dev/null 2>&1 && return 0
  fi
  awk -F: -v group="${group}" '$1 == group {found=1} END {exit !found}' "${NIX_GROUP_FILE}" 2>/dev/null
}

layer8_eligibility() {
  [ -d "${NIX_INSTALL_ROOT}" ] || { echo "unsupported: ${NIX_INSTALL_ROOT} directory missing"; return; }
  nix_is_mounted || { echo "unsupported: ${NIX_INSTALL_ROOT} is not mounted"; return; }
  detect_real_nix || { echo "unsupported: Layer 4 real Nix missing"; return; }
  [ -x "${NIX_DAEMON_BIN}" ] || { echo "unsupported: nix-daemon binary missing: ${NIX_DAEMON_BIN}"; return; }
  systemd_unit_path "${NIX_DAEMON_SOCKET}" >/dev/null 2>&1 || { echo "unsupported: ${NIX_DAEMON_SOCKET} unit missing"; return; }
  systemd_unit_path "${NIX_DAEMON_SERVICE}" >/dev/null 2>&1 || { echo "unsupported: ${NIX_DAEMON_SERVICE} unit missing"; return; }
  group=$(layer8_build_users_group)
  case "${group}" in
    ""|"(no nix.conf)") echo "unsupported: build-users-group is empty (single-user/root config)"; return ;;
    "(default)") group=nixbld ;;
  esac
  group_exists "${group}" || { echo "unsupported: build-users-group '${group}' is not present"; return; }
  echo "available: daemon prerequisites present"
}

systemctl_available() {
  if [ -n "${NIX_SYSTEMCTL}" ] && command -v "${NIX_SYSTEMCTL}" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

systemctl_state() {
  unit=$1
  if systemctl_available; then
    "${NIX_SYSTEMCTL}" is-active "${unit}" 2>/dev/null || true
  else
    echo unknown
  fi
}

print_layer8_status() {
  echo "Layer 8 (experimental daemon) status"
  echo "--------------------------------------"
  state=$(layer8_state)
  eligibility=$(layer8_eligibility)
  socket_unit=$(systemd_unit_path "${NIX_DAEMON_SOCKET}" 2>/dev/null || echo "missing")
  service_unit=$(systemd_unit_path "${NIX_DAEMON_SERVICE}" 2>/dev/null || echo "missing")
  build_group=$(layer8_build_users_group)

  echo "  state:      ${state}"
  echo "  eligible:   ${eligibility}"
  echo "  daemon:     ${NIX_DAEMON_BIN}"
  echo "  socket:     ${socket_unit}"
  echo "  service:    ${service_unit}"
  echo "  sock path:  ${NIX_DAEMON_SOCKET_PATH}"
  echo "  build grp:  ${build_group}"
  echo "  socket run: $(systemctl_state "${NIX_DAEMON_SOCKET}")"
  echo "  service run: $(systemctl_state "${NIX_DAEMON_SERVICE}")"
  echo "  fallback:   Layer 4 single-user/root Nix remains primary unless daemon is explicitly enabled"
}

layer9_kernel_ready() {
  [ "${NIX_LAYER9_SKIP_KERNEL_CHECK}" = "1" ] && return 0
  [ -e /proc/self/ns/mnt ] || return 1
  [ -e /proc/self/ns/pid ] || return 1
  [ -e /proc/self/ns/uts ] || return 1
  [ -d /sys/fs/cgroup ] || return 1
  return 0
}

layer9_guest_root_ready() {
  [ -d "${NIX_LAYER9_GUEST_ROOT}" ] || return 1
  [ -d "${NIX_LAYER9_GUEST_ROOT}/etc" ] || [ -d "${NIX_LAYER9_GUEST_ROOT}/usr" ] || [ -d "${NIX_LAYER9_GUEST_ROOT}/nix" ]
}

layer9_running() {
  if [ -f "${NIX_LAYER9_STATE_DIR}/state" ]; then
    state=$(awk 'NR==1 {print; exit}' "${NIX_LAYER9_STATE_DIR}/state")
    [ "${state}" = "running" ] && return 0
  fi
  if have ps; then
    ps -ef 2>/dev/null | grep '[s]ystemd-nspawn' | grep -F -- "${NIX_LAYER9_GUEST_ROOT}" >/dev/null 2>&1 && return 0
  fi
  return 1
}

layer9_state() {
  [ -x "${NIX_LAYER9_NSPAWN_BIN}" ] || { echo unsupported; return; }
  layer9_kernel_ready || { echo unsupported; return; }
  layer9_running && { echo running; return; }
  if [ -d "${NIX_LAYER9_GUEST_ROOT}" ]; then
    if layer9_guest_root_ready; then
      echo proof-ready
    else
      echo available
    fi
  else
    echo available
  fi
}

layer9_eligibility() {
  [ -x "${NIX_LAYER9_NSPAWN_BIN}" ] || { echo "unsupported: systemd-nspawn missing: ${NIX_LAYER9_NSPAWN_BIN}"; return; }
  layer9_kernel_ready || { echo "unsupported: namespace/cgroup prerequisites missing"; return; }
  if [ ! -e "${NIX_LAYER9_GUEST_ROOT}" ]; then
    echo "available: guest root missing: ${NIX_LAYER9_GUEST_ROOT}"
    return
  fi
  [ -d "${NIX_LAYER9_GUEST_ROOT}" ] || { echo "unsupported: guest root is not a directory: ${NIX_LAYER9_GUEST_ROOT}"; return; }
  layer9_guest_root_ready || { echo "available: guest root present but not proof-ready: ${NIX_LAYER9_GUEST_ROOT}"; return; }
  echo "available: nspawn guest proof prerequisites present"
}

print_layer9_status() {
  echo "Layer 9 (nspawn guest proof) status"
  echo "------------------------------------"
  state=$(layer9_state)
  eligibility=$(layer9_eligibility)

  echo "  state:      ${state}"
  echo "  eligible:   ${eligibility}"
  echo "  nspawn:     ${NIX_LAYER9_NSPAWN_BIN}"
  echo "  guest root: ${NIX_LAYER9_GUEST_ROOT}"
  echo "  state dir:  ${NIX_LAYER9_STATE_DIR}"
  if layer9_running; then
    echo "  running:    yes"
  else
    echo "  running:    no"
  fi
  echo "  fallback:   host Layers 4/8 remain the recovery path; guest cleanup must not touch host Nix state"
}

layer10_kernel_ready() {
  [ "${NIX_LAYER10_SKIP_KERNEL_CHECK}" = "1" ] && return 0
  layer9_kernel_ready
}

layer10_rootfs_mode() {
  if [ ! -e "${NIX_LAYER10_GUEST_ROOT}" ]; then
    echo absent
    return
  fi
  if [ ! -d "${NIX_LAYER10_GUEST_ROOT}" ]; then
    echo invalid
    return
  fi
  if [ -x "${NIX_LAYER10_GUEST_ROOT}/sbin/init" ] || \
     [ -x "${NIX_LAYER10_GUEST_ROOT}/init" ] || \
     [ -x "${NIX_LAYER10_GUEST_ROOT}/usr/lib/systemd/systemd" ] || \
     [ -x "${NIX_LAYER10_GUEST_ROOT}/lib/systemd/systemd" ]; then
    echo bootable
    return
  fi
  if [ -d "${NIX_LAYER10_GUEST_ROOT}/nix" ] || \
     [ -x "${NIX_LAYER10_GUEST_ROOT}/bin/sh" ] || \
     [ -x "${NIX_LAYER10_GUEST_ROOT}/usr/bin/nix" ]; then
    echo proof
    return
  fi
  echo invalid
}

layer10_state_value() {
  if [ -f "${NIX_LAYER10_STATE_DIR}/state" ]; then
    awk 'NR==1 {print; exit}' "${NIX_LAYER10_STATE_DIR}/state"
  else
    echo inactive
  fi
}

layer10_unit_path() {
  dirs="${NIX_LAYER10_SYSTEMD_DIR} /storage/.config/system.d /usr/lib/systemd/system /etc/systemd/system"
  for dir in ${dirs}; do
    [ -n "${dir}" ] || continue
    if [ -f "${dir}/${NIX_LAYER10_UNIT_NAME}" ]; then
      echo "${dir}/${NIX_LAYER10_UNIT_NAME}"
      return 0
    fi
  done
  return 1
}

layer10_running() {
  if systemctl_available; then
    [ "$(systemctl_state "${NIX_LAYER10_UNIT_NAME}")" = "active" ] && return 0
  fi
  if have ps; then
    ps -ef 2>/dev/null | grep '[s]ystemd-nspawn' | grep -F -- "${NIX_LAYER10_GUEST_ROOT}" >/dev/null 2>&1 && return 0
  fi
  return 1
}

layer10_state() {
  [ -x "${NIX_LAYER10_NSPAWN_BIN}" ] || { echo unsupported; return; }
  layer10_kernel_ready || { echo unsupported; return; }
  layer10_running && { echo running; return; }
  case "$(layer10_state_value)" in
    running) echo failed; return ;;
    failed|partial) echo failed; return ;;
  esac
  case "$(layer10_rootfs_mode)" in
    absent) echo available ;;
    proof) echo proof-ready ;;
    bootable) echo bootable-ready ;;
    invalid) echo invalid ;;
    *) echo invalid ;;
  esac
}

layer10_eligibility() {
  [ -x "${NIX_LAYER10_NSPAWN_BIN}" ] || { echo "unsupported: systemd-nspawn missing: ${NIX_LAYER10_NSPAWN_BIN}"; return; }
  layer10_kernel_ready || { echo "unsupported: namespace/cgroup prerequisites missing"; return; }
  case "$(layer10_rootfs_mode)" in
    absent) echo "available: guest root missing: ${NIX_LAYER10_GUEST_ROOT}" ;;
    proof) echo "available: proof rootfs ready for run/shell; start requires bootable rootfs" ;;
    bootable) echo "available: bootable guest root ready for manual start" ;;
    invalid) echo "unsupported: guest root invalid or unsupported: ${NIX_LAYER10_GUEST_ROOT}" ;;
    *) echo "unsupported: guest root mode unknown: ${NIX_LAYER10_GUEST_ROOT}" ;;
  esac
}

print_layer10_status() {
  echo "Layer 10 (managed nspawn guest operations) status"
  echo "--------------------------------------------------"
  state=$(layer10_state)
  mode=$(layer10_rootfs_mode)
  eligibility=$(layer10_eligibility)
  unit_path=$(layer10_unit_path 2>/dev/null || echo missing)

  echo "  state:      ${state}"
  echo "  mode:       ${mode}"
  echo "  eligible:   ${eligibility}"
  echo "  nspawn:     ${NIX_LAYER10_NSPAWN_BIN}"
  echo "  guest root: ${NIX_LAYER10_GUEST_ROOT}"
  echo "  state dir:  ${NIX_LAYER10_STATE_DIR}"
  echo "  unit:       ${unit_path}"
  echo "  unit run:   $(systemctl_state "${NIX_LAYER10_UNIT_NAME}")"
  echo "  resources:  CPUWeight=${NIX_LAYER10_CPU_WEIGHT} IOWeight=${NIX_LAYER10_IO_WEIGHT} MemoryMax=${NIX_LAYER10_MEMORY_MAX} TasksMax=${NIX_LAYER10_TASKS_MAX}"
  if layer10_running; then
    echo "  running:    yes"
  else
    echo "  running:    no"
  fi
  echo "  autostart:  disabled by contract"
  echo "  fallback:   host SSH and Layers 4/8 remain the recovery path"
}

layer11_bridge_name_valid() {
  name=${1:-}
  [ -n "${name}" ] || return 1
  case "${name}" in
    *[!A-Za-z0-9._-]*|.*|*..*|*/*) return 1 ;;
  esac
  return 0
}

layer11_bridge_count() {
  [ -d "${NIX_LAYER11_STATE_DIR}/bridges" ] || { echo 0; return; }
  find "${NIX_LAYER11_STATE_DIR}/bridges" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | awk '{print $1}'
}

layer11_bridge_dir() {
  echo "${NIX_LAYER11_STATE_DIR}/bridges/$1"
}

layer11_bridge_target() {
  echo "${NIX_LAYER11_BIN_DIR}/$1"
}

layer11_metadata_value() {
  key=$1
  file=$2
  [ -f "${file}" ] || return 1
  awk -F= -v key="${key}" '$1 == key {sub(/^[^=]*=/, ""); print; found=1; exit} END {exit !found}' "${file}"
}

layer11_owns_bridge() {
  name=$1
  target=$(layer11_bridge_target "${name}")
  metadata="$(layer11_bridge_dir "${name}")/metadata"
  [ -f "${metadata}" ] || return 1
  recorded=$(layer11_metadata_value target "${metadata}" 2>/dev/null || true)
  [ "${recorded}" = "${target}" ] || return 1
  return 0
}

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

layer11_command_line() {
  [ $# -gt 0 ] || return 1
  line=
  for arg in "$@"; do
    quoted=$(shell_quote "${arg}")
    if [ -n "${line}" ]; then
      line="${line} ${quoted}"
    else
      line="${quoted}"
    fi
  done
  printf '%s\n' "${line}"
}

layer11_target_path_safe() {
  path=$1
  real=$(canonical_path "${path}")
  case "${real}" in
    /storage/bin/*|/tmp/*/layer11-bin/*) return 0 ;;
  esac
  return 1
}

layer11_state_path_safe() {
  path=$1
  real=$(canonical_path "${path}")
  case "${real}" in
    /storage/.config/nix-integration/layer11|/tmp/*/layer11-state) return 0 ;;
  esac
  return 1
}

layer11_eligibility() {
  [ -d "${NIX_LAYER11_BIN_DIR}" ] || { echo "unsupported: bridge bin dir missing: ${NIX_LAYER11_BIN_DIR}"; return; }
  [ -w "${NIX_LAYER11_BIN_DIR}" ] || { echo "unsupported: bridge bin dir not writable: ${NIX_LAYER11_BIN_DIR}"; return; }
  case "$(layer10_state)" in
    proof-ready|bootable-ready) echo "available: Layer 10 one-shot guest execution ready" ;;
    running) echo "unsupported: Layer 10 guest is running; stop it before bridge operations" ;;
    available) echo "unsupported: Layer 10 guest root missing or not ready" ;;
    unsupported) echo "unsupported: Layer 10 guest operations unsupported" ;;
    invalid) echo "unsupported: Layer 10 guest root invalid" ;;
    failed|partial) echo "unsupported: Layer 10 guest state requires cleanup or repair" ;;
    *) echo "unsupported: Layer 10 guest state unknown" ;;
  esac
}

print_layer11_status() {
  echo "Layer 11 (one-shot guest-backed bridges) status"
  echo "------------------------------------------------"
  echo "  state dir:  ${NIX_LAYER11_STATE_DIR}"
  echo "  bin dir:    ${NIX_LAYER11_BIN_DIR}"
  echo "  bridges:    $(layer11_bridge_count)"
  echo "  eligible:   $(layer11_eligibility)"
  echo "  execution:  one-shot via nixctl guest run"
  echo "  autostart:  disabled by contract"
  echo "  fallback:   host SSH remains the recovery path; bridges must leave Layer 10 stopped"
}

print_layer7_status() {
  echo "Layer 7 (app/UI experiment) status"
  echo "------------------------------------"
  echo "  app:      ${NIX_LAYER7_APP_NAME}"
  echo "  expected: ${NIX_LAYER7_APP_BIN}"

  if app_bin=$(layer7_resolved_app_binary); then
    real=$(canonical_path "${app_bin}")
    echo "  binary:   ${app_bin}"
    echo "  realpath: ${real}"
    if layer7_binary_is_nix_backed "${app_bin}"; then
      echo "  origin:   Nix profile/store"
    else
      echo "  origin:   unsafe/non-Nix"
    fi
  else
    echo "  binary:   missing (install with standard nix profile first)"
    echo "  origin:   unavailable"
  fi

  launcher=$(layer7_launcher_path)
  if [ -x "${launcher}" ]; then
    if layer6_owns_target "${launcher}"; then
      echo "  launcher: active and Layer 6-owned: ${launcher}"
    else
      echo "  launcher: present but not Layer 6-owned: ${launcher}"
    fi
  else
    echo "  launcher: inactive: ${launcher}"
  fi

  snippet=$(layer7_profile_snippet_path)
  if [ -f "${snippet}" ]; then
    if layer6_owns_target "${snippet}"; then
      echo "  profile:  active and Layer 6-owned: ${snippet}"
    else
      echo "  profile:  present but not Layer 6-owned: ${snippet}"
    fi
  else
    echo "  profile:  inactive: ${snippet}"
  fi

  echo "  state:    ${NIX_LAYER7_APP_STATE_DIR}"
  echo "  config:   ${NIX_LAYER7_APP_CONFIG_DIR}"
  echo "  cache:    ${NIX_LAYER7_APP_CACHE_DIR}"
  if layer7_path_safe "${NIX_LAYER7_APP_STATE_DIR}" && layer7_path_safe "${NIX_LAYER7_APP_CONFIG_DIR}" && layer7_path_safe "${NIX_LAYER7_APP_CACHE_DIR}"; then
    echo "  paths ok: yes"
  else
    echo "  paths ok: no (outside Layer 7 experiment roots)"
  fi
}

# ---- Subcommands -----------------------------------------------------------

cmd_status() {
  echo "Layer 4 (real Nix) status"
  echo "------------------------"
  if detect_real_nix; then
    version_line=$("${NIX_BIN}" --version 2>&1 | head -1 || echo "(failed to query)")
    echo "  installed: yes"
    echo "  binary:    ${NIX_BIN}"
    echo "  version:   ${version_line}"
    echo "  config:    ${NIX_USER_CONFIG_FILE}"
    echo "  sandbox:   $(read_sandbox_setting)"
  else
    echo "  installed: no"
    echo "  expected:  ${NIX_DEFAULT_PROFILE_BIN}/nix"
    echo "  hint:      run '${0##*/} install' to bootstrap real Nix"
  fi
  echo ""
  echo "Layer 3 (storage-backed /nix) status"
  echo "------------------------------------"
  echo "  $(report_nix_mount)"
  echo ""
  echo "Shell PATH resolution"
  echo "---------------------"
  echo "  which nix -> $(report_path_resolution)"
  echo ""
  print_layer5_profile_status
  echo ""
  print_layer6_status
  echo ""
  print_layer7_status
  echo ""
  print_layer8_status
  echo ""
  print_layer9_status
  echo ""
  print_layer10_status
  echo ""
  print_layer11_status
  echo ""
}

cmd_install() {
  # Idempotency: skip if already at the pinned version.
  if detect_real_nix; then
    current=$("${NIX_BIN}" --version 2>/dev/null | awk '{print $NF}' | head -1 || true)
    if [ "${current}" = "${NIX_VERSION}" ]; then
      info "Nix ${NIX_VERSION} is already installed at ${NIX_BIN}"
      cleanup_legacy_portable_wrappers
      info "Re-run with NIX_FORCE=1 to reinstall, or use 'nixctl upgrade --version <X.Y.Z>' to switch versions"
      if [ "${NIX_FORCE:-}" != "1" ]; then
        return 0
      fi
    else
      info "Nix ${current} is already installed; replacing with ${NIX_VERSION}"
    fi
  fi

  check_arch
  check_storage
  check_nix_mount

  mkdir -p "${NIX_CACHE_DIR}"
  tarball="${NIX_CACHE_DIR}/nix-${NIX_VERSION}-${NIX_TARBALL_ARCH}.tar.xz"
  extract_dir="${NIX_CACHE_DIR}/nix-${NIX_VERSION}-${NIX_TARBALL_ARCH}"

  # Reuse a previously-downloaded tarball if it matches.
  if [ -f "${tarball}" ]; then
    if [ "$(sha256_of "${tarball}")" = "${NIX_TARBALL_SHA256}" ]; then
      info "Reusing cached tarball ${tarball}"
    else
      info "Cached tarball checksum mismatch; re-downloading"
      rm -f "${tarball}"
    fi
  fi

  if [ ! -f "${tarball}" ]; then
    info "Downloading ${NIX_TARBALL_URL}"
    download_tarball "${NIX_TARBALL_URL}" "${tarball}"
    info "Verifying tarball sha256"
    verify_tarball "${tarball}"
  fi

  rm -rf "${extract_dir}"
  info "Extracting to ${NIX_CACHE_DIR}"
  tar -xJf "${tarball}" -C "${NIX_CACHE_DIR}"
  [ -x "${extract_dir}/install" ] || fail "installer missing in tarball: ${extract_dir}/install"

  # Patch the upstream installer for busybox cp compatibility. ROCKNIX ships
  # busybox coreutils, which do not support GNU's --preserve=ownership,
  # timestamps. The -RPp shorthand preserves the same attributes via the
  # legacy -p flag and works on both GNU and busybox cp. The chmod a-w that
  # follows enforces store invariants regardless.
  sed -i 's|cp -RP --preserve=ownership,timestamps|cp -RPp|g' "${extract_dir}/install"

  # Clean any partial /nix/store state from a previous failed install attempt.
  if [ -d "${NIX_INSTALL_ROOT}/store" ]; then
    find "${NIX_INSTALL_ROOT}/store" -maxdepth 1 -name '*.tmp.*' -exec rm -rf {} + 2>/dev/null || true
  fi

  # Write nix.conf BEFORE running the installer. The installer's last step is
  # `nix-env -i $nix` to seed the default profile, which reads the user
  # nix.conf. Without our build-users-group= override, it would try to use
  # the default 'nixbld' group, which ROCKNIX does not have (no useradd/
  # groupadd available -- single-user-as-root is structural).
  info "Writing initial ${NIX_USER_CONFIG_FILE} (sandbox=true; will probe after install)"
  write_nix_conf true

  # Run the official upstream installer in single-user mode with overrides
  # that suppress its assumptions about writable /etc and shell rc files.
  # Resulting layout under /nix matches what the script ships, which keeps us
  # aligned with upstream's evolving conventions.
  info "Running upstream installer (single-user, no profile/channel mods)"
  USER="${USER:-root}" \
  HOME="${HOME:-/storage}" \
  NIX_INSTALLER_NO_MODIFY_PROFILE=1 \
  NIX_INSTALLER_NO_CHANNEL_ADD=1 \
  NIX_INSTALLER_YES=1 \
  NIX_SSL_CERT_FILE="${NIX_SSL_CERT_FILE:-${NIX_SSL_CERT_FILE_DEFAULT}}" \
  "${extract_dir}/install" --no-daemon

  detect_real_nix || fail "upstream installer completed but ${NIX_DEFAULT_PROFILE_BIN}/nix is missing"

  info "Probing sandbox support"
  probe_log="${NIX_CACHE_DIR}/sandbox-probe.log"
  if probe_sandbox "${probe_log}"; then
    info "Sandbox probe succeeded; nix.conf keeps sandbox = true"
  else
    info "Sandbox probe failed; falling back to sandbox = false"
    note "See ${probe_log} for the upstream error"
    write_nix_conf false
  fi

  info "Final smoke: ${NIX_BIN} --version"
  "${NIX_BIN}" --version || fail "final smoke failed"

  cleanup_legacy_portable_wrappers

  info "Layer 4 install complete"
  note "Open a fresh shell or run 'hash -r' so \$PATH picks up the new nix binary"
  note "Try: nix run nixpkgs#hello"
}

cmd_upgrade() {
  # Parse --version <X.Y.Z> if provided. Otherwise upgrade to the pinned
  # NIX_VERSION (which is what install also targets). Idempotency in
  # cmd_install handles the 'already at target' case.
  while [ $# -gt 0 ]; do
    case $1 in
      --version)
        [ $# -ge 2 ] || fail "upgrade: --version requires an argument"
        # When --version is provided, NIX_TARBALL_SHA256 must be different
        # from the pinned default. If the user did not export an explicit
        # sha, our top-level defaulting filled in the pinned value, which is
        # almost certainly wrong for a different version. The download's
        # sha-check is still the authoritative gate; this is the early-fail
        # nudge.
        if [ "${NIX_TARBALL_SHA256}" = "${NIX_TARBALL_SHA256_PINNED}" ] && [ "$2" != "${NIX_VERSION_PINNED}" ]; then
          fail "upgrade --version ${2} requires NIX_TARBALL_SHA256 to be exported with the sha256 of nix-${2}-${NIX_TARBALL_ARCH}.tar.xz"
        fi
        NIX_VERSION=$2
        NIX_TARBALL_URL="https://releases.nixos.org/nix/nix-${NIX_VERSION}/nix-${NIX_VERSION}-${NIX_TARBALL_ARCH}.tar.xz"
        shift 2
        ;;
      -h|--help)
        cat <<EOF
Usage: ${0##*/} upgrade [--version <X.Y.Z>]

Upgrades real Nix to the pinned version (default) or to a specified version.
When --version is provided, NIX_TARBALL_SHA256 must be set to the matching
sha256 of the upstream tarball.

Examples:
  ${0##*/} upgrade
  NIX_TARBALL_SHA256=<hex> ${0##*/} upgrade --version 2.35.0
EOF
        return 0
        ;;
      *)
        fail "upgrade: unknown argument: $1"
        ;;
    esac
  done

  # Delegate to install. Its idempotency check handles the 'already at
  # version' case (reports cleanly, exits 0). To force reinstall at the same
  # version, set NIX_FORCE=1 in the environment.
  cmd_install
}

cmd_uninstall() {
  # Parse --yes for non-interactive use.
  assume_yes=0
  while [ $# -gt 0 ]; do
    case $1 in
      --yes|-y) assume_yes=1; shift ;;
      -h|--help)
        cat <<EOF
Usage: ${0##*/} uninstall [--yes]

Removes real Nix and per-user config, restoring the system to the Layer 3
substrate. Removes:

  ${NIX_INSTALL_ROOT}/store/*
  ${NIX_INSTALL_ROOT}/var/*
  ${NIX_USER_CONFIG_DIR}
  \${HOME}/.nix-defexpr
  \${HOME}/.nix-profile (symlink)
  \${HOME}/.nix-channels

Leaves the Layer 3 bind mount itself intact. Unqualified Nix commands belong
to Layer 4 and should disappear after uninstall.

For non-interactive use (scripts, smoke tests), pass --yes.
EOF
        return 0
        ;;
      *)
        fail "uninstall: unknown argument: $1"
        ;;
    esac
  done

  # Idempotency: detect what's actually present. The bare mountpoints
  # /nix/store and /nix/var/nix are also created by Layer 3's
  # nix-storage-setup.service and by uninstall itself, so we look for actual
  # content (store entries, profile dirs, user config) rather than directory
  # existence.
  found_anything=0
  if [ -d "${NIX_INSTALL_ROOT}/store" ] && [ -n "$(ls -A "${NIX_INSTALL_ROOT}/store" 2>/dev/null || true)" ]; then
    found_anything=1
  fi
  if [ -d "${NIX_INSTALL_ROOT}/var/nix/profiles" ] || [ -d "${NIX_INSTALL_ROOT}/var/nix/gcroots" ]; then
    found_anything=1
  fi
  for path in \
    "${NIX_USER_CONFIG_DIR}" \
    "${HOME:-/storage}/.nix-defexpr" \
    "${HOME:-/storage}/.nix-profile" \
    "${HOME:-/storage}/.nix-channels"; do
    if [ -e "${path}" ] || [ -L "${path}" ]; then
      found_anything=1
      break
    fi
  done

  if [ "${found_anything}" -eq 0 ]; then
    info "Nothing to uninstall: real Nix is not present"
    return 0
  fi

  # Layer 6 may activate wrappers/snippets that point at /nix/store. Refuse
  # to remove the real store while those files are active; deactivate Layer 6
  # first so user-env files are cleaned up through their ownership metadata.
  if layer6_active; then
    fail "uninstall: Layer 6 user environment is active; run '${0##*/} user-env deactivate' before removing real Nix"
  fi

  # Confirmation gate.
  if [ "${assume_yes}" -ne 1 ]; then
    if [ ! -t 0 ] || [ ! -t 1 ]; then
      fail "uninstall: refusing to run non-interactively without --yes"
    fi
    printf 'About to remove real Nix from %s and per-user state from %s.\nContinue? [y/N] ' \
      "${NIX_INSTALL_ROOT}" "${HOME:-/storage}"
    read -r answer
    case "${answer}" in
      y|Y|yes|YES) ;;
      *) info "Aborted."; return 1 ;;
    esac
  fi

  info "Removing /nix/store and /nix/var"
  # /nix is a bind mount; remove its contents but not the mount point.
  rm -rf "${NIX_INSTALL_ROOT}/store" "${NIX_INSTALL_ROOT}/var" 2>&1 || true
  # Recreate empty store mountpoint so subsequent installs find a writable
  # parent. The Layer 3 nix-storage-setup.service does this on boot, but we
  # may not reboot between uninstall and install.
  mkdir -p "${NIX_INSTALL_ROOT}/store" "${NIX_INSTALL_ROOT}/var/nix"

  info "Removing per-user Nix state"
  rm -rf "${NIX_USER_CONFIG_DIR}" 2>&1 || true
  rm -rf "${HOME:-/storage}/.nix-defexpr" 2>&1 || true
  rm -f "${HOME:-/storage}/.nix-profile" 2>&1 || true
  rm -f "${HOME:-/storage}/.nix-channels" 2>&1 || true

  # Layer 3 substrate (bind mount) is intact.
  info "Layer 4 uninstall complete"
  note "Layer 3 bind mount remains active: ${NIX_INSTALL_ROOT}"
  note "To reinstall Layer 4, run: ${0##*/} install"
}

cmd_doctor() {
  if have nix-doctor; then
    info "Delegating to nix-doctor for Nix integration checks."
    exec nix-doctor "$@"
  fi
  fail "doctor: nix-doctor not found on \$PATH (expected /usr/bin/nix-doctor)"
}

cmd_user_env() {
  [ $# -gt 0 ] || fail "user-env: missing action (status, preflight, activate, deactivate, rollback)"
  activate_bin=$(layer6_activate_bin) || fail "user-env: nix-layer-activate not found on \$PATH or /usr/bin"
  NIX_LAYER6_STATE_DIR="${NIX_LAYER6_STATE_DIR}" \
  NIX_LAYER6_BIN_DIR="${NIX_LAYER6_BIN_DIR}" \
  NIX_LAYER6_PROFILE_D_DIR="${NIX_LAYER6_PROFILE_D_DIR}" \
    exec "${activate_bin}" "$@"
}

layer8_write_state() {
  state=$1
  mkdir -p "${NIX_LAYER8_STATE_DIR}"
  printf '%s\n' "${state}" >"${NIX_LAYER8_STATE_DIR}/state"
  date -u +%Y-%m-%dT%H:%M:%SZ >"${NIX_LAYER8_STATE_DIR}/updated-at"
}

cmd_daemon_status() {
  print_layer8_status
}

cmd_daemon_preflight() {
  eligibility=$(layer8_eligibility)
  case "${eligibility}" in
    available:*)
      info "Layer 8 daemon preflight passed"
      note "${eligibility}"
      ;;
    *)
      fail "daemon preflight failed: ${eligibility}"
      ;;
  esac
}

cmd_daemon_enable() {
  cmd_daemon_preflight
  systemctl_available || fail "daemon enable requires systemctl"
  layer8_write_state enabled
  if "${NIX_SYSTEMCTL}" enable --now "${NIX_DAEMON_SOCKET}"; then
    layer8_write_state enabled
    info "Layer 8 daemon socket enabled: ${NIX_DAEMON_SOCKET}"
  else
    layer8_write_state partial
    fail "daemon enable failed; state marked partial, run '${0##*/} daemon rollback'"
  fi
}

cmd_daemon_disable() {
  if systemctl_available; then
    "${NIX_SYSTEMCTL}" disable --now "${NIX_DAEMON_SOCKET}" >/dev/null 2>&1 || true
    "${NIX_SYSTEMCTL}" stop "${NIX_DAEMON_SERVICE}" >/dev/null 2>&1 || true
  else
    note "systemctl unavailable; removing Layer 8 metadata only"
  fi
  rm -rf "${NIX_LAYER8_STATE_DIR}"
  info "Layer 8 daemon mode disabled; Layer 4 single-user/root Nix is unchanged"
}

cmd_daemon_rollback() {
  cmd_daemon_disable
}

cmd_daemon() {
  [ $# -gt 0 ] || fail "daemon: missing action (status, preflight, enable, disable, rollback)"
  action=$1
  shift
  case "${action}" in
    status)
      cmd_daemon_status "$@"
      ;;
    preflight|plan)
      cmd_daemon_preflight "$@"
      ;;
    enable|activate)
      cmd_daemon_enable "$@"
      ;;
    disable|deactivate)
      cmd_daemon_disable "$@"
      ;;
    rollback)
      cmd_daemon_rollback "$@"
      ;;
    *)
      fail "daemon: unknown action: ${action}"
      ;;
  esac
}

cmd_guest_status() {
  print_layer10_status
}

cmd_guest_preflight() {
  eligibility=$(layer10_eligibility)
  case "${eligibility}" in
    "available: proof rootfs ready"*|"available: bootable guest root ready"*)
      info "Layer 10 guest preflight passed"
      note "${eligibility}"
      ;;
    *)
      fail "guest preflight failed: ${eligibility}"
      ;;
  esac
}

layer10_write_state() {
  state=$1
  mkdir -p "${NIX_LAYER10_STATE_DIR}"
  printf '%s\n' "${state}" >"${NIX_LAYER10_STATE_DIR}/state"
  date -u +%Y-%m-%dT%H:%M:%SZ >"${NIX_LAYER10_STATE_DIR}/updated-at" 2>/dev/null || true
}

layer10_resolve_bash_bin() {
  if [ -n "${NIX_LAYER10_BASH_BIN}" ] && [ -x "${NIX_LAYER10_BASH_BIN}" ]; then
    canonical_path "${NIX_LAYER10_BASH_BIN}"
    return 0
  fi
  find "${NIX_INSTALL_ROOT}/store" -maxdepth 4 -type f -path '*/bin/bash' -perm /111 2>/dev/null | head -1
}

cmd_guest_init() {
  mode=${1:-}
  [ "${mode}" = "--proof" ] || fail "guest init currently supports only: --proof"
  [ ! -e "${NIX_LAYER10_GUEST_ROOT}" ] || fail "guest init: root already exists: ${NIX_LAYER10_GUEST_ROOT}; run guest cleanup --yes first"
  [ -x "${NIX_LAYER10_NIX_BIN}" ] || fail "guest init: real nix binary missing: ${NIX_LAYER10_NIX_BIN}"
  [ -x "${NIX_LAYER10_NIX_STORE_BIN}" ] || fail "guest init: nix-store binary missing: ${NIX_LAYER10_NIX_STORE_BIN}"
  bash_bin=$(layer10_resolve_bash_bin)
  [ -n "${bash_bin}" ] && [ -x "${bash_bin}" ] || fail "guest init: could not find executable bash in ${NIX_INSTALL_ROOT}/store"

  info "Staging proof rootfs at ${NIX_LAYER10_GUEST_ROOT}"
  mkdir -p \
    "${NIX_LAYER10_GUEST_ROOT}/bin" \
    "${NIX_LAYER10_GUEST_ROOT}/usr/bin" \
    "${NIX_LAYER10_GUEST_ROOT}/nix/store" \
    "${NIX_LAYER10_GUEST_ROOT}/etc" \
    "${NIX_LAYER10_GUEST_ROOT}/tmp" \
    "${NIX_LAYER10_GUEST_ROOT}/proc" \
    "${NIX_LAYER10_GUEST_ROOT}/sys" \
    "${NIX_LAYER10_GUEST_ROOT}/dev"
  chmod 1777 "${NIX_LAYER10_GUEST_ROOT}/tmp"
  printf 'NAME=rocknix-layer10-proof\nID=rocknix-layer10-proof\n' >"${NIX_LAYER10_GUEST_ROOT}/etc/os-release"

  refs_file="${NIX_LAYER10_GUEST_ROOT}/tmp/closure-refs"
  "${NIX_LAYER10_NIX_STORE_BIN}" -qR "${NIX_LAYER10_NIX_BIN}" "${NIX_LAYER10_NIX_STORE_BIN}" "${bash_bin}" >"${refs_file}"
  while IFS= read -r ref; do
    [ -n "${ref}" ] || continue
    [ -e "${ref}" ] || fail "guest init: closure ref missing: ${ref}"
    cp -a "${ref}" "${NIX_LAYER10_GUEST_ROOT}/nix/store/"
  done <"${refs_file}"
  rm -f "${refs_file}"

  ln -s "${bash_bin}" "${NIX_LAYER10_GUEST_ROOT}/bin/sh"
  ln -s "${bash_bin}" "${NIX_LAYER10_GUEST_ROOT}/bin/bash"
  ln -s "$(canonical_path "${NIX_LAYER10_NIX_BIN}")" "${NIX_LAYER10_GUEST_ROOT}/usr/bin/nix"
  ln -s "$(canonical_path "${NIX_LAYER10_NIX_STORE_BIN}")" "${NIX_LAYER10_GUEST_ROOT}/usr/bin/nix-store"

  layer10_write_state proof-ready
  info "Layer 10 proof rootfs staged"
}

cmd_guest_run() {
  [ $# -gt 0 ] || fail "guest run: missing command"
  cmd_guest_preflight
  mode=$(layer10_rootfs_mode)
  case "${mode}" in
    proof|bootable) ;;
    *) fail "guest run: unsupported rootfs mode: ${mode}" ;;
  esac
  if layer10_running; then
    fail "guest run: guest appears to be running; stop it before one-shot proof commands"
  fi
  mkdir -p "${NIX_LAYER10_STATE_DIR}"
  info "Running one-shot Layer 10 guest command (${mode})"
  layer10_write_state running
  if have timeout; then
    if timeout "${NIX_LAYER10_TIMEOUT}" "${NIX_LAYER10_NSPAWN_BIN}" --quiet --register=no --directory="${NIX_LAYER10_GUEST_ROOT}" "$@" >"${NIX_LAYER10_LOG}" 2>&1; then
      layer10_write_state "${mode}-ready"
      cat "${NIX_LAYER10_LOG}"
      return 0
    fi
  else
    if "${NIX_LAYER10_NSPAWN_BIN}" --quiet --register=no --directory="${NIX_LAYER10_GUEST_ROOT}" "$@" >"${NIX_LAYER10_LOG}" 2>&1; then
      layer10_write_state "${mode}-ready"
      cat "${NIX_LAYER10_LOG}"
      return 0
    fi
  fi
  layer10_write_state failed
  cat "${NIX_LAYER10_LOG}" >&2 2>/dev/null || true
  fail "guest run failed; state marked failed, log: ${NIX_LAYER10_LOG}"
}

cmd_guest_shell() {
  cmd_guest_run /bin/sh "$@"
}

layer10_unit_dir() {
  if [ -n "${NIX_LAYER10_SYSTEMD_DIR}" ]; then
    echo "${NIX_LAYER10_SYSTEMD_DIR}"
  else
    echo /storage/.config/system.d
  fi
}

layer10_write_unit() {
  unit_dir=$(layer10_unit_dir)
  mkdir -p "${unit_dir}"
  unit_path="${unit_dir}/${NIX_LAYER10_UNIT_NAME}"
  cat >"${unit_path}" <<EOF
[Unit]
Description=ROCKNIX Layer 10 nspawn guest
Documentation=internal:projects/ROCKNIX/packages/tools/nix-integration/docs/layer10-guest-lifecycle-contract.md
RequiresMountsFor=/storage
After=nix.mount

[Service]
Type=simple
KillMode=mixed
Delegate=yes
TasksMax=${NIX_LAYER10_TASKS_MAX}
CPUWeight=${NIX_LAYER10_CPU_WEIGHT}
IOWeight=${NIX_LAYER10_IO_WEIGHT}
MemoryMax=${NIX_LAYER10_MEMORY_MAX}
ExecStart=${NIX_LAYER10_NSPAWN_BIN} --boot --register=no --directory=${NIX_LAYER10_GUEST_ROOT}
EOF
  echo "${unit_path}"
}

cmd_guest_start() {
  cmd_guest_preflight
  mode=$(layer10_rootfs_mode)
  [ "${mode}" = "bootable" ] || fail "guest start: rootfs mode is ${mode}; start requires bootable rootfs (use guest run/shell for proof roots)"
  if layer10_running; then
    info "Layer 10 guest already running"
    return 0
  fi
  systemctl_available || fail "guest start requires systemctl"
  unit_path=$(layer10_write_unit)
  info "Starting Layer 10 bootable guest with disabled unit: ${unit_path}"
  "${NIX_SYSTEMCTL}" daemon-reload >/dev/null 2>&1 || true
  layer10_write_state starting
  if "${NIX_SYSTEMCTL}" start "${NIX_LAYER10_UNIT_NAME}"; then
    layer10_write_state running
    info "Layer 10 guest started: ${NIX_LAYER10_UNIT_NAME}"
  else
    layer10_write_state failed
    fail "guest start failed; state marked failed"
  fi
}

cmd_guest_stop() {
  if systemctl_available; then
    "${NIX_SYSTEMCTL}" stop "${NIX_LAYER10_UNIT_NAME}" >/dev/null 2>&1 || true
  else
    note "systemctl unavailable; clearing Layer 10 running metadata only"
  fi
  layer10_write_state stopped
  if have ps && ps -ef 2>/dev/null | grep '[s]ystemd-nspawn' | grep -F -- "${NIX_LAYER10_GUEST_ROOT}" >/dev/null 2>&1; then
    layer10_write_state failed
    fail "guest stop: nspawn process still appears to reference ${NIX_LAYER10_GUEST_ROOT}"
  fi
  info "Layer 10 guest stopped"
}

layer10_cleanup_path_safe() {
  path=$1
  real=$(canonical_path "${path}")
  case "${real}" in
    /storage/machines/*|/tmp/*/layer10-*) return 0 ;;
  esac
  return 1
}

layer10_cleanup_state_path_safe() {
  path=$1
  real=$(canonical_path "${path}")
  case "${real}" in
    /storage/.config/nix-integration/layer10|/tmp/*/layer10-*) return 0 ;;
  esac
  return 1
}

cmd_guest_cleanup() {
  assume_yes=0
  while [ $# -gt 0 ]; do
    case $1 in
      --yes|-y) assume_yes=1; shift ;;
      *) fail "guest cleanup: unknown argument: $1" ;;
    esac
  done

  if layer10_running; then
    fail "guest cleanup: guest appears to be running; stop it before cleanup"
  fi
  layer10_cleanup_path_safe "${NIX_LAYER10_GUEST_ROOT}" || fail "guest cleanup: refusing unsafe guest root: ${NIX_LAYER10_GUEST_ROOT}"
  layer10_cleanup_state_path_safe "${NIX_LAYER10_STATE_DIR}" || fail "guest cleanup: refusing unsafe state dir: ${NIX_LAYER10_STATE_DIR}"

  if [ "${assume_yes}" -ne 1 ]; then
    if [ ! -t 0 ] || [ ! -t 1 ]; then
      fail "guest cleanup: refusing to run non-interactively without --yes"
    fi
    printf 'About to remove Layer 10 guest root %s and state %s.\nContinue? [y/N] ' \
      "${NIX_LAYER10_GUEST_ROOT}" "${NIX_LAYER10_STATE_DIR}"
    read -r answer
    case "${answer}" in
      y|Y|yes|YES) ;;
      *) info "Aborted."; return 1 ;;
    esac
  fi

  rm -rf "${NIX_LAYER10_GUEST_ROOT}" "${NIX_LAYER10_STATE_DIR}" 2>/dev/null || true
  info "Layer 10 guest state cleaned"
}

cmd_guest() {
  [ $# -gt 0 ] || fail "guest: missing action (status, preflight, init, run, shell, start, stop, cleanup)"
  action=$1
  shift
  case "${action}" in
    status)
      cmd_guest_status "$@"
      ;;
    preflight|plan)
      cmd_guest_preflight "$@"
      ;;
    init)
      cmd_guest_init "$@"
      ;;
    run)
      cmd_guest_run "$@"
      ;;
    shell)
      cmd_guest_shell "$@"
      ;;
    start)
      cmd_guest_start "$@"
      ;;
    stop)
      cmd_guest_stop "$@"
      ;;
    cleanup)
      cmd_guest_cleanup "$@"
      ;;
    *)
      fail "guest: unknown action: ${action}"
      ;;
  esac
}

cmd_bridge_status() {
  print_layer11_status
}

cmd_bridge_preflight() {
  name=${1:-}
  [ -n "${name}" ] || fail "bridge preflight: missing bridge name"
  layer11_bridge_name_valid "${name}" || fail "bridge preflight: unsafe bridge name: ${name}"
  eligibility=$(layer11_eligibility)
  case "${eligibility}" in
    available:*)
      info "Layer 11 bridge preflight passed: ${name}"
      note "${eligibility}"
      ;;
    *)
      fail "bridge preflight failed: ${eligibility}"
      ;;
  esac
}

cmd_bridge_install() {
  name=${1:-}
  [ -n "${name}" ] || fail "bridge install: missing bridge name"
  shift || true
  [ "${1:-}" = "--" ] || fail "bridge install: expected -- before guest command"
  shift
  [ $# -gt 0 ] || fail "bridge install: missing guest command"
  cmd_bridge_preflight "${name}"

  target=$(layer11_bridge_target "${name}")
  metadata_dir=$(layer11_bridge_dir "${name}")
  metadata="${metadata_dir}/metadata"
  command_file="${metadata_dir}/command"
  layer11_target_path_safe "${target}" || fail "bridge install: refusing unsafe target path: ${target}"
  layer11_state_path_safe "${NIX_LAYER11_STATE_DIR}" || fail "bridge install: refusing unsafe state dir: ${NIX_LAYER11_STATE_DIR}"

  if [ -e "${target}" ] || [ -L "${target}" ]; then
    layer11_owns_bridge "${name}" || fail "bridge install: target exists and is not owned by Layer 11: ${target}"
  fi

  command_line=$(layer11_command_line "$@") || fail "bridge install: could not encode guest command"
  mkdir -p "${NIX_LAYER11_BIN_DIR}" "${metadata_dir}"
  tmp_target="${target}.tmp.$$"
  cat >"${tmp_target}" <<EOF
#!/bin/sh
set -eu
exec /usr/bin/nixctl bridge run ${name}
EOF
  chmod 0755 "${tmp_target}"
  mv -f "${tmp_target}" "${target}"

  {
    printf 'name=%s\n' "${name}"
    printf 'target=%s\n' "${target}"
    printf 'guest_root=%s\n' "${NIX_LAYER10_GUEST_ROOT}"
    date -u '+installed_at=%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf 'installed_at=unknown\n'
  } >"${metadata}"
  printf '%s\n' "${command_line}" >"${command_file}"
  info "Layer 11 bridge installed: ${target}"
}

cmd_bridge_remove() {
  name=${1:-}
  [ -n "${name}" ] || fail "bridge remove: missing bridge name"
  layer11_bridge_name_valid "${name}" || fail "bridge remove: unsafe bridge name: ${name}"
  target=$(layer11_bridge_target "${name}")
  metadata_dir=$(layer11_bridge_dir "${name}")
  layer11_target_path_safe "${target}" || fail "bridge remove: refusing unsafe target path: ${target}"
  layer11_state_path_safe "${NIX_LAYER11_STATE_DIR}" || fail "bridge remove: refusing unsafe state dir: ${NIX_LAYER11_STATE_DIR}"
  layer11_owns_bridge "${name}" || fail "bridge remove: bridge is not Layer 11-owned: ${name}"
  rm -f "${target}"
  rm -rf "${metadata_dir}"
  info "Layer 11 bridge removed: ${name}"
}

cmd_bridge() {
  [ $# -gt 0 ] || fail "bridge: missing action (status, preflight, install, remove)"
  action=$1
  shift
  case "${action}" in
    status)
      cmd_bridge_status "$@"
      ;;
    preflight|plan)
      cmd_bridge_preflight "$@"
      ;;
    install)
      cmd_bridge_install "$@"
      ;;
    remove|uninstall)
      cmd_bridge_remove "$@"
      ;;
    *)
      fail "bridge: unknown action: ${action}"
      ;;
  esac
}

# ---- Dispatch --------------------------------------------------------------

if [ $# -eq 0 ]; then
  usage >&2
  exit 1
fi

cmd=$1
shift

case "${cmd}" in
  status)
    cmd_status "$@"
    ;;
  install)
    cmd_install "$@"
    ;;
  upgrade)
    cmd_upgrade "$@"
    ;;
  uninstall|remove)
    cmd_uninstall "$@"
    ;;
  doctor)
    cmd_doctor "$@"
    ;;
  user-env|env)
    cmd_user_env "$@"
    ;;
  daemon)
    cmd_daemon "$@"
    ;;
  guest)
    cmd_guest "$@"
    ;;
  bridge)
    cmd_bridge "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "${0##*/}: unknown subcommand: ${cmd}" >&2
    usage >&2
    exit 1
    ;;
esac
