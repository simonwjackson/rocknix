#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)

set -u

NIX_PORTABLE_DIR="${NIX_PORTABLE_DIR:-/storage/apps/nix-portable}"
NIX_PORTABLE_BIN="${NIX_PORTABLE_BIN:-${NIX_PORTABLE_DIR}/nix-portable}"
NIX_PORTABLE_RUNNER="${NIX_PORTABLE_RUNNER:-${NIX_PORTABLE_DIR}/bin/nix-portable-run}"
NIX_DOCTOR="${NIX_DOCTOR:-${NIX_PORTABLE_DIR}/bin/nix-doctor}"
NIX_WRAPPER_DIR="${NIX_WRAPPER_DIR:-/storage/bin}"
NIX_PORTABLE_REQUIRED_MB="${NIX_PORTABLE_REQUIRED_MB:-512}"
NP_LOCATION="${NP_LOCATION:-/storage}"
NP_RUNTIME="${NP_RUNTIME:-proot}"

# ---- Layer 3 / Layer 4 paths ---------------------------------------------
NIX_INSTALL_ROOT="${NIX_INSTALL_ROOT:-/nix}"
NIX_DEFAULT_PROFILE_BIN="${NIX_DEFAULT_PROFILE_BIN:-${NIX_INSTALL_ROOT}/var/nix/profiles/default/bin}"
NIX_USER_HOME="${HOME:-/storage}"
NIX_USER_CONFIG_FILE="${NIX_USER_CONFIG_FILE:-${NIX_USER_HOME}/.config/nix/nix.conf}"
NIX_USER_PROFILE_LINK="${NIX_USER_PROFILE_LINK:-${NIX_USER_HOME}/.nix-profile}"
NIX_USER_PROFILE_BIN="${NIX_USER_PROFILE_BIN:-${NIX_USER_PROFILE_LINK}/bin}"
NIX_PROFILE_STORAGE_WARN_MB="${NIX_PROFILE_STORAGE_WARN_MB:-2048}"
NIX_LAYER6_STATE_DIR="${NIX_LAYER6_STATE_DIR:-/storage/.config/nix-integration/layer6}"
NIX_LAYER6_BIN_DIR="${NIX_LAYER6_BIN_DIR:-/storage/bin}"
NIX_LAYER6_PROFILE_D_DIR="${NIX_LAYER6_PROFILE_D_DIR:-/storage/.config/profile.d}"
NIX_LAYER6_ACTIVATE="${NIX_LAYER6_ACTIVATE:-}"
NIX_LAYER7_APP_NAME="${NIX_LAYER7_APP_NAME:-browser}"
NIX_LAYER7_APP_BIN="${NIX_LAYER7_APP_BIN:-chromium}"
NIX_LAYER7_APP_BIN_PATH="${NIX_LAYER7_APP_BIN_PATH:-}"
NIX_LAYER7_LAUNCHER_NAME="${NIX_LAYER7_LAUNCHER_NAME:-rocknix-layer7-browser}"
NIX_LAYER7_PROFILE_SNIPPET="${NIX_LAYER7_PROFILE_SNIPPET:-999-rocknix-layer7-browser}"
NIX_LAYER7_APP_STATE_DIR="${NIX_LAYER7_APP_STATE_DIR:-${NIX_USER_HOME}/.local/share/nix-apps/layer7/${NIX_LAYER7_APP_NAME}}"
NIX_LAYER7_APP_CONFIG_DIR="${NIX_LAYER7_APP_CONFIG_DIR:-${NIX_USER_HOME}/.config/nix-apps/layer7/${NIX_LAYER7_APP_NAME}}"
NIX_LAYER7_APP_CACHE_DIR="${NIX_LAYER7_APP_CACHE_DIR:-${NIX_USER_HOME}/.cache/nix-apps/layer7/${NIX_LAYER7_APP_NAME}}"
NIX_LAYER8_STATE_DIR="${NIX_LAYER8_STATE_DIR:-/storage/.config/nix-integration/layer8}"
NIX_LAYER8_SYSTEMD_DIR="${NIX_LAYER8_SYSTEMD_DIR:-}"
NIX_DAEMON_BIN="${NIX_DAEMON_BIN:-${NIX_DEFAULT_PROFILE_BIN}/nix-daemon}"
NIX_DAEMON_SERVICE="${NIX_DAEMON_SERVICE:-nix-daemon.service}"
NIX_DAEMON_SOCKET="${NIX_DAEMON_SOCKET:-nix-daemon.socket}"
NIX_DAEMON_SOCKET_PATH="${NIX_DAEMON_SOCKET_PATH:-${NIX_INSTALL_ROOT}/var/nix/daemon-socket/socket}"
NIX_GROUP_FILE="${NIX_GROUP_FILE:-/etc/group}"
CHECK_NETWORK=1
RUN_SMOKE=1
RUN_DEV_SHELL_SMOKE=0
NIX_DEV_SHELL_SMOKE_PACKAGE="${NIX_DEV_SHELL_SMOKE_PACKAGE:-nixpkgs#jq}"
NIX_DEV_SHELL_SMOKE_COMMAND="${NIX_DEV_SHELL_SMOKE_COMMAND:-jq --version}"
FAILURES=0
WARNINGS=0

usage() {
  cat <<EOF
Usage: ${0##*/} [--offline] [--no-smoke] [--dev-shell-smoke]

Checks the ROCKNIX storage-only nix-portable layer.

Options:
  --offline          Skip network checks.
  --no-smoke         Skip running 'nix --version'.
  --dev-shell-smoke  Also run a practical 'nix shell' smoke command.

Dev shell smoke defaults can be overridden with:
  NIX_DEV_SHELL_SMOKE_PACKAGE=${NIX_DEV_SHELL_SMOKE_PACKAGE}
  NIX_DEV_SHELL_SMOKE_COMMAND='${NIX_DEV_SHELL_SMOKE_COMMAND}'
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --offline)
      CHECK_NETWORK=0
      ;;
    --no-smoke)
      RUN_SMOKE=0
      ;;
    --dev-shell-smoke)
      RUN_DEV_SHELL_SMOKE=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "${0##*/}: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

ok() {
  echo "OK: $*"
}

warn() {
  WARNINGS=$((WARNINGS + 1))
  echo "WARN: $*"
}

fail_check() {
  FAILURES=$((FAILURES + 1))
  echo "FAIL: $*"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

sha256_file() {
  if have sha256sum; then
    sha256sum "$1" | awk '{print $1}'
  elif have openssl; then
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  else
    return 1
  fi
}

canonical_path() {
  path=$1
  if [ -e "${path}" ] || [ -L "${path}" ]; then
    readlink -f "${path}" 2>/dev/null || echo "${path}"
  else
    echo "${path}"
  fi
}

is_expected_nix_tool_shadow() {
  case "$1" in
    nix|nix-build|nix-channel|nix-collect-garbage|nix-copy-closure|nix-daemon|nix-env|nix-hash|nix-instantiate|nix-prefetch-url|nix-shell|nix-store)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

layer6_activate_bin() {
  if [ -n "${NIX_LAYER6_ACTIVATE}" ] && [ -x "${NIX_LAYER6_ACTIVATE}" ]; then
    echo "${NIX_LAYER6_ACTIVATE}"
    return 0
  fi
  if have nix-layer-activate; then
    command -v nix-layer-activate
    return 0
  fi
  if [ -x /usr/bin/nix-layer-activate ]; then
    echo /usr/bin/nix-layer-activate
    return 0
  fi
  return 1
}

layer6_owns_target() {
  target=$1
  owned="${NIX_LAYER6_STATE_DIR}/owned-files"
  [ -f "${owned}" ] || return 1
  awk -F'|' -v target="${target}" '$1 == target {found=1} END {exit !found}' "${owned}"
}

layer7_launcher_path() {
  echo "${NIX_LAYER6_BIN_DIR}/${NIX_LAYER7_LAUNCHER_NAME}"
}

layer7_profile_snippet_path() {
  echo "${NIX_LAYER6_PROFILE_D_DIR}/${NIX_LAYER7_PROFILE_SNIPPET}"
}

layer7_resolved_app_binary() {
  if [ -n "${NIX_LAYER7_APP_BIN_PATH}" ]; then
    [ -x "${NIX_LAYER7_APP_BIN_PATH}" ] || return 1
    echo "${NIX_LAYER7_APP_BIN_PATH}"
    return 0
  fi
  if [ -x "${NIX_USER_PROFILE_BIN}/${NIX_LAYER7_APP_BIN}" ]; then
    echo "${NIX_USER_PROFILE_BIN}/${NIX_LAYER7_APP_BIN}"
    return 0
  fi
  if have "${NIX_LAYER7_APP_BIN}"; then
    command -v "${NIX_LAYER7_APP_BIN}"
    return 0
  fi
  return 1
}

layer7_binary_is_nix_backed() {
  candidate=$1
  real=$(canonical_path "${candidate}")
  case "${candidate}" in
    ${NIX_USER_PROFILE_BIN}/*) return 0 ;;
  esac
  case "${real}" in
    ${NIX_INSTALL_ROOT}/store/*|/storage/.nix-root/store/*) return 0 ;;
  esac
  return 1
}

layer7_path_safe() {
  case "$1" in
    ${NIX_USER_HOME}/.local/share/nix-apps/layer7/*|${NIX_USER_HOME}/.config/nix-apps/layer7/*|${NIX_USER_HOME}/.cache/nix-apps/layer7/*|/storage/.local/share/nix-apps/layer7/*|/storage/.config/nix-apps/layer7/*|/storage/.cache/nix-apps/layer7/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

systemd_unit_path() {
  unit=$1
  dirs="${NIX_LAYER8_SYSTEMD_DIR} /storage/.config/system.d /usr/lib/systemd/system /etc/systemd/system"
  for dir in ${dirs}; do
    [ -n "${dir}" ] || continue
    if [ -f "${dir}/${unit}" ]; then
      echo "${dir}/${unit}"
      return 0
    fi
  done
  return 1
}

nix_is_mounted() {
  awk -v p="${NIX_INSTALL_ROOT}" '$2 == p {found=1} END {exit !found}' /proc/mounts 2>/dev/null
}

layer8_state() {
  if [ -f "${NIX_LAYER8_STATE_DIR}/state" ]; then
    awk 'NR==1 {print; exit}' "${NIX_LAYER8_STATE_DIR}/state"
  else
    echo inactive
  fi
}

layer8_build_users_group() {
  if [ ! -f "${NIX_USER_CONFIG_FILE}" ]; then
    echo "(no nix.conf)"
    return
  fi
  awk -F= '
    /^[[:space:]]*build-users-group[[:space:]]*=/ {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
      print $2
      found=1
      exit
    }
    END { if (!found) print "(default)" }
  ' "${NIX_USER_CONFIG_FILE}"
}

group_exists() {
  group=$1
  [ -n "${group}" ] || return 1
  if have getent; then
    getent group "${group}" >/dev/null 2>&1 && return 0
  fi
  awk -F: -v group="${group}" '$1 == group {found=1} END {exit !found}' "${NIX_GROUP_FILE}" 2>/dev/null
}

layer8_eligibility() {
  [ -d "${NIX_INSTALL_ROOT}" ] || { echo "unsupported: ${NIX_INSTALL_ROOT} directory missing"; return; }
  nix_is_mounted || { echo "unsupported: ${NIX_INSTALL_ROOT} is not mounted"; return; }
  [ -x "${NIX_DEFAULT_PROFILE_BIN}/nix" ] || { echo "unsupported: Layer 4 real Nix missing"; return; }
  [ -x "${NIX_DAEMON_BIN}" ] || { echo "unsupported: nix-daemon binary missing: ${NIX_DAEMON_BIN}"; return; }
  systemd_unit_path "${NIX_DAEMON_SOCKET}" >/dev/null 2>&1 || { echo "unsupported: ${NIX_DAEMON_SOCKET} unit missing"; return; }
  systemd_unit_path "${NIX_DAEMON_SERVICE}" >/dev/null 2>&1 || { echo "unsupported: ${NIX_DAEMON_SERVICE} unit missing"; return; }
  group=$(layer8_build_users_group)
  case "${group}" in
    ""|"(no nix.conf)") echo "unsupported: build-users-group is empty (single-user/root config)"; return ;;
    "(default)") group=nixbld ;;
  esac
  group_exists "${group}" || { echo "unsupported: build-users-group '${group}' is not present"; return; }
  echo "available: daemon prerequisites present"
}

check_profile_command_conflicts() {
  if [ ! -d "${NIX_USER_PROFILE_BIN}" ]; then
    return
  fi

  found=0
  for profile_cmd in "${NIX_USER_PROFILE_BIN}"/*; do
    [ -e "${profile_cmd}" ] || continue
    [ -x "${profile_cmd}" ] || continue
    [ ! -d "${profile_cmd}" ] || continue

    name=${profile_cmd##*/}
    profile_real=$(canonical_path "${profile_cmd}")
    for dir in "${NIX_DEFAULT_PROFILE_BIN}" "${NIX_WRAPPER_DIR}" /usr/bin /usr/sbin; do
      candidate="${dir}/${name}"
      [ "${candidate}" != "${profile_cmd}" ] || continue
      [ -e "${candidate}" ] || continue
      [ -x "${candidate}" ] || continue
      candidate_real=$(canonical_path "${candidate}")
      [ "${candidate_real}" != "${profile_real}" ] || continue
      if [ "${dir}" = "${NIX_WRAPPER_DIR}" ] && is_expected_nix_tool_shadow "${name}"; then
        continue
      fi
      warn "Layer 5 command shadowing: ${profile_cmd} shadows ${candidate}"
      found=1
    done
  done

  if [ "${found}" -eq 0 ]; then
    ok "Layer 5 profile command conflicts: none detected"
  fi
}

check_architecture() {
  arch=$(uname -m 2>/dev/null || echo unknown)
  case "${arch}" in
    aarch64|arm64)
      ok "architecture is ${arch}"
      ;;
    *)
      warn "architecture is ${arch}; this experiment is validated on SM8550/aarch64 only"
      ;;
  esac
}

check_root_model() {
  root_flags=$(awk '$2 == "/" {print $4; exit}' /proc/mounts 2>/dev/null)
  case ",${root_flags}," in
    *,ro,*) ok "root filesystem is read-only" ;;
    *,rw,*) warn "root filesystem appears writable; ROCKNIX device root is expected to be read-only" ;;
    *) warn "could not determine root filesystem flags" ;;
  esac
}

check_storage() {
  if [ -d "${NP_LOCATION}" ]; then
    ok "storage location exists: ${NP_LOCATION}"
  else
    fail_check "storage location missing: ${NP_LOCATION}"
    return
  fi

  if [ -w "${NP_LOCATION}" ]; then
    ok "storage location is writable: ${NP_LOCATION}"
  else
    fail_check "storage location is not writable: ${NP_LOCATION}"
  fi

  available_mb=$(df -m "${NP_LOCATION}" 2>/dev/null | awk 'NR==2 {print $4}')
  case "${available_mb}" in
    ''|*[!0-9]*)
      fail_check "could not determine free space for ${NP_LOCATION}"
      ;;
    *)
      if [ "${available_mb}" -ge "${NIX_PORTABLE_REQUIRED_MB}" ]; then
        ok "storage free space ${available_mb}MB >= ${NIX_PORTABLE_REQUIRED_MB}MB"
      else
        fail_check "storage free space ${available_mb}MB < ${NIX_PORTABLE_REQUIRED_MB}MB"
      fi
      ;;
  esac
}

check_artifact() {
  if [ -x "${NIX_PORTABLE_BIN}" ]; then
    ok "nix-portable executable exists: ${NIX_PORTABLE_BIN}"
  else
    fail_check "nix-portable missing or not executable: ${NIX_PORTABLE_BIN}"
    return
  fi

  if [ -f "${NIX_PORTABLE_BIN}.sha256" ]; then
    expected=$(awk 'NR==1 {print $1}' "${NIX_PORTABLE_BIN}.sha256")
    if actual=$(sha256_file "${NIX_PORTABLE_BIN}"); then
      if [ "${actual}" = "${expected}" ]; then
        ok "nix-portable checksum matches recorded sha256"
      else
        fail_check "nix-portable checksum mismatch: expected ${expected}, got ${actual}"
      fi
    else
      fail_check "sha256sum or openssl is required to verify nix-portable"
    fi
  else
    fail_check "missing checksum metadata: ${NIX_PORTABLE_BIN}.sha256"
  fi
}

check_wrappers() {
  if [ -x "${NIX_PORTABLE_RUNNER}" ]; then
    ok "runner exists: ${NIX_PORTABLE_RUNNER}"
  else
    fail_check "runner missing or not executable: ${NIX_PORTABLE_RUNNER}"
  fi

  if [ -x "${NIX_DOCTOR}" ]; then
    ok "doctor exists: ${NIX_DOCTOR}"
  else
    warn "doctor helper is not installed in storage: ${NIX_DOCTOR}"
  fi

  for wrapper in nix nix-shell nix-run nix-dev-shell nix-doctor; do
    if [ -x "${NIX_WRAPPER_DIR}/${wrapper}" ]; then
      ok "wrapper exists: ${NIX_WRAPPER_DIR}/${wrapper}"
    else
      fail_check "wrapper missing or not executable: ${NIX_WRAPPER_DIR}/${wrapper}"
    fi
  done
}

check_runtime() {
  if [ "${NP_RUNTIME}" = "proot" ]; then
    ok "NP_RUNTIME is proot"
  else
    warn "NP_RUNTIME is '${NP_RUNTIME}', but ROCKNIX SM8550 currently requires proot"
  fi

  if [ "${RUN_SMOKE}" -eq 1 ]; then
    if [ -x "${NIX_WRAPPER_DIR}/nix" ]; then
      if output=$(NP_RUNTIME="${NP_RUNTIME}" NP_LOCATION="${NP_LOCATION}" "${NIX_WRAPPER_DIR}/nix" --version 2>&1); then
        ok "nix smoke command succeeded: ${output}"
      else
        fail_check "nix smoke command failed: ${output}"
      fi
    else
      fail_check "cannot run smoke command because ${NIX_WRAPPER_DIR}/nix is missing"
    fi
  else
    warn "nix smoke command skipped"
  fi
}

check_dev_shell() {
  if [ "${RUN_DEV_SHELL_SMOKE}" -eq 0 ]; then
    return
  fi

  if [ ! -x "${NIX_WRAPPER_DIR}/nix" ]; then
    fail_check "cannot run dev shell smoke because ${NIX_WRAPPER_DIR}/nix is missing"
    return
  fi

  if output=$(NP_RUNTIME="${NP_RUNTIME}" NP_LOCATION="${NP_LOCATION}" "${NIX_WRAPPER_DIR}/nix" shell "${NIX_DEV_SHELL_SMOKE_PACKAGE}" --command sh -c "${NIX_DEV_SHELL_SMOKE_COMMAND}" 2>&1); then
    ok "dev shell smoke command succeeded: ${output}"
  else
    fail_check "dev shell smoke command failed for ${NIX_DEV_SHELL_SMOKE_PACKAGE}: ${output}"
  fi
}

# Layer 3: report whether /nix is the storage-backed bind mount expected by
# the nix-storage-setup.service + nix.mount unit pair. Reports OK when the
# bind is in place, WARN when /nix exists but is a regular directory.
check_layer3_mount() {
  if [ ! -d "${NIX_INSTALL_ROOT}" ]; then
    fail_check "${NIX_INSTALL_ROOT} does not exist; Layer 3 substrate missing"
    return
  fi
  if awk -v p="${NIX_INSTALL_ROOT}" '$2 == p {found=1} END {exit !found}' /proc/mounts 2>/dev/null; then
    ok "${NIX_INSTALL_ROOT} is mounted (Layer 3 substrate active)"
  else
    warn "${NIX_INSTALL_ROOT} is a regular directory, not a bind mount; Layer 3 may not be active"
  fi
}

# Layer 4: only runs the new checks when real Nix is actually installed.
# When absent, this is a no-op and the doctor output is unchanged from the
# Layer 1/2/3 baseline.
check_layer4() {
  layer4_nix="${NIX_DEFAULT_PROFILE_BIN}/nix"
  if [ ! -x "${layer4_nix}" ]; then
    return  # Layer 4 not installed; nothing to check
  fi

  ok "Layer 4 detected: real Nix at ${layer4_nix}"

  # nix --version with explicit path; verify no proot in the process tree of
  # the spawned nix.
  if version_output=$("${layer4_nix}" --version 2>&1); then
    ok "real nix --version: ${version_output}"
  else
    fail_check "real nix --version failed: ${version_output}"
  fi

  # Verify nothing in the process tree calls into nix-portable. Spawn a
  # short-lived nix and inspect its parent chain. This is best-effort -- if
  # /proc is restricted or pgrep is unavailable, fall back to grep-of-self.
  if pid_in_tree=$(pgrep -f nix-portable 2>/dev/null | head -1); then
    if [ -n "${pid_in_tree}" ]; then
      warn "a nix-portable process is currently running (pid ${pid_in_tree}); not necessarily wrong, but worth noting"
    fi
  fi

  # User config: nix.conf existence and parseable sandbox setting.
  if [ -f "${NIX_USER_CONFIG_FILE}" ]; then
    ok "user nix.conf present: ${NIX_USER_CONFIG_FILE}"
    sandbox_setting=$(awk -F= '
      /^[[:space:]]*sandbox[[:space:]]*=/ {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit
      }
    ' "${NIX_USER_CONFIG_FILE}")
    case "${sandbox_setting}" in
      true|false|relaxed)
        ok "sandbox = ${sandbox_setting}"
        ;;
      "")
        warn "sandbox setting not present in nix.conf (will use Nix default)"
        ;;
      *)
        warn "sandbox setting has unexpected value: '${sandbox_setting}'"
        ;;
    esac
  else
    fail_check "user nix.conf missing: ${NIX_USER_CONFIG_FILE}"
  fi

  # ~/.nix-profile must resolve to a real path (the actual default profile).
  if [ -L "${NIX_USER_PROFILE_LINK}" ]; then
    target=$(readlink "${NIX_USER_PROFILE_LINK}" 2>/dev/null || echo "")
    if [ -e "${NIX_USER_PROFILE_LINK}" ]; then
      ok "\${HOME}/.nix-profile -> ${target}"
    else
      fail_check "\${HOME}/.nix-profile is a dangling symlink to ${target}"
    fi
  else
    warn "\${HOME}/.nix-profile is missing or not a symlink (expected after nixctl install)"
  fi

  # Shell PATH agreement: which nix should resolve to the real nix once
  # profile.d is sourced. On a fresh nixctl install via SSH (without
  # 'hash -r' or a fresh shell), this may still resolve to the portable
  # wrapper. WARN, do not fail.
  if path_nix=$(command -v nix 2>/dev/null); then
    case "${path_nix}" in
      "${NIX_DEFAULT_PROFILE_BIN}/nix"|"${NIX_USER_PROFILE_LINK}/bin/nix")
        ok "\$PATH 'nix' resolves to real nix: ${path_nix}"
        ;;
      "${NIX_WRAPPER_DIR}/nix")
        warn "\$PATH 'nix' resolves to portable wrapper (${path_nix}); open a fresh shell or run 'hash -r'"
        ;;
      *)
        warn "\$PATH 'nix' resolves to unexpected path: ${path_nix}"
        ;;
    esac
  else
    warn "no 'nix' on \$PATH; profile.d may not be sourced in this shell"
  fi
}

check_layer5() {
  layer4_nix="${NIX_DEFAULT_PROFILE_BIN}/nix"
  if [ ! -x "${layer4_nix}" ]; then
    return  # Layer 5 depends on Layer 4 real Nix.
  fi

  if [ ! -L "${NIX_USER_PROFILE_LINK}" ]; then
    if [ -e "${NIX_USER_PROFILE_LINK}" ]; then
      fail_check "Layer 5 profile exists but is not a symlink: ${NIX_USER_PROFILE_LINK}"
    else
      warn "Layer 5 profile link is missing: ${NIX_USER_PROFILE_LINK}"
    fi
    return
  fi

  target=$(readlink "${NIX_USER_PROFILE_LINK}" 2>/dev/null || echo "")
  if [ ! -e "${NIX_USER_PROFILE_LINK}" ]; then
    fail_check "Layer 5 profile is a dangling symlink to ${target}"
    return
  fi
  ok "Layer 5 profile link: ${NIX_USER_PROFILE_LINK} -> ${target}"

  if [ -d "${NIX_USER_PROFILE_BIN}" ]; then
    ok "Layer 5 profile bin exists: ${NIX_USER_PROFILE_BIN}"
  else
    fail_check "Layer 5 profile bin missing: ${NIX_USER_PROFILE_BIN}"
    return
  fi

  if profile_list=$("${layer4_nix}" --extra-experimental-features 'nix-command flakes' profile list 2>&1); then
    if [ -n "${profile_list}" ]; then
      ok "nix profile list succeeded"
    else
      ok "nix profile list succeeded (no profile entries reported)"
    fi
  else
    fail_check "nix profile list failed: ${profile_list}"
  fi

  check_profile_command_conflicts

  available_mb=$(df -m "${NP_LOCATION}" 2>/dev/null | awk 'NR==2 {print $4}')
  case "${available_mb}" in
    ''|*[!0-9]*) ;;
    *)
      if [ "${available_mb}" -lt "${NIX_PROFILE_STORAGE_WARN_MB}" ]; then
        warn "storage free space ${available_mb}MB < ${NIX_PROFILE_STORAGE_WARN_MB}MB; profile installs may exhaust /storage"
      fi
      ;;
  esac
}

check_layer6() {
  if [ ! -d "${NIX_LAYER6_STATE_DIR}" ]; then
    ok "Layer 6 state absent (no managed user environment active)"
    return
  fi

  state=absent
  if [ -f "${NIX_LAYER6_STATE_DIR}/state" ]; then
    state=$(awk 'NR==1 {print; exit}' "${NIX_LAYER6_STATE_DIR}/state")
  fi
  case "${state}" in
    absent|inactive)
      ok "Layer 6 state: ${state}"
      return
      ;;
    active)
      ok "Layer 6 state: active"
      ;;
    partial)
      fail_check "Layer 6 state is partial; run nixctl user-env rollback or inspect ${NIX_LAYER6_STATE_DIR}"
      ;;
    *)
      warn "Layer 6 state has unexpected value: ${state}"
      ;;
  esac

  if activate_bin=$(layer6_activate_bin); then
    if status_output=$(NIX_LAYER6_STATE_DIR="${NIX_LAYER6_STATE_DIR}" \
      NIX_LAYER6_BIN_DIR="${NIX_LAYER6_BIN_DIR}" \
      NIX_LAYER6_PROFILE_D_DIR="${NIX_LAYER6_PROFILE_D_DIR}" \
      "${activate_bin}" status 2>&1); then
      ok "Layer 6 status command succeeded"
    else
      fail_check "Layer 6 status command failed: ${status_output}"
    fi
  else
    fail_check "Layer 6 state exists but nix-layer-activate is not available"
  fi

  owned="${NIX_LAYER6_STATE_DIR}/owned-files"
  if [ ! -f "${owned}" ]; then
    if [ "${state}" = "active" ]; then
      fail_check "Layer 6 active state missing owned-files metadata: ${owned}"
    fi
    return
  fi

  count=$(awk 'NF {c++} END {print c+0}' "${owned}")
  ok "Layer 6 owned files recorded: ${count}"

  while IFS='|' read -r target sha source mode generation; do
    [ -n "${target}" ] || continue
    case "${target}" in
      /storage/bin/*|/storage/.config/profile.d/*|${NIX_LAYER6_BIN_DIR%/}/*|${NIX_LAYER6_PROFILE_D_DIR%/}/*|${NIX_WRAPPER_DIR%/}/*|${NIX_USER_HOME}/.config/profile.d/*) ;;
      *) fail_check "Layer 6 owned target outside allowed storage surfaces: ${target}" ;;
    esac
    if [ ! -e "${target}" ] && [ ! -L "${target}" ]; then
      fail_check "Layer 6 owned target missing: ${target}"
      continue
    fi
    current_sha=$(sha256_file "${target}" 2>/dev/null || echo "")
    if [ -n "${sha}" ] && [ "${current_sha}" = "${sha}" ]; then
      ok "Layer 6 owned target matches metadata: ${target}"
    else
      fail_check "Layer 6 owned target modified externally: ${target}"
    fi
    if [ -n "${source}" ] && [ "${source}" != "-" ] && [ ! -e "${source}" ]; then
      fail_check "Layer 6 source missing for ${target}: ${source}"
    fi
    if grep -q '/nix/store/' "${target}" 2>/dev/null; then
      missing_store_refs=$(grep -o '/nix/store/[^ "'"'"'`$]*' "${target}" 2>/dev/null | while IFS= read -r ref; do [ -e "${ref}" ] || echo "${ref}"; done | head -3)
      if [ -n "${missing_store_refs}" ]; then
        fail_check "Layer 6 owned target references missing Nix store path(s): ${target}: ${missing_store_refs}"
      fi
    fi
    case "${target}" in
      */.config/profile.d/[0-8][0-9][0-9]*|*/.config/profile.d/09[0-8]*)
        warn "Layer 6 profile snippet may sort before late PATH resets: ${target}"
        ;;
    esac
  done <"${owned}"
}

check_layer7() {
  launcher=$(layer7_launcher_path)
  snippet=$(layer7_profile_snippet_path)
  layer7_active=0

  if [ -x "${launcher}" ]; then
    if layer6_owns_target "${launcher}"; then
      ok "Layer 7 launcher active and Layer 6-owned: ${launcher}"
      layer7_active=1
    else
      warn "Layer 7 launcher exists but is not Layer 6-owned: ${launcher}"
    fi
  else
    ok "Layer 7 launcher inactive: ${launcher}"
  fi

  if [ -f "${snippet}" ]; then
    if layer6_owns_target "${snippet}"; then
      ok "Layer 7 profile snippet active and Layer 6-owned: ${snippet}"
      layer7_active=1
    else
      warn "Layer 7 profile snippet exists but is not Layer 6-owned: ${snippet}"
    fi
  else
    ok "Layer 7 profile snippet inactive: ${snippet}"
  fi

  if layer7_path_safe "${NIX_LAYER7_APP_STATE_DIR}"; then
    ok "Layer 7 app state path is safe: ${NIX_LAYER7_APP_STATE_DIR}"
  else
    fail_check "Layer 7 app state path outside allowed experiment roots: ${NIX_LAYER7_APP_STATE_DIR}"
  fi
  if layer7_path_safe "${NIX_LAYER7_APP_CONFIG_DIR}"; then
    ok "Layer 7 app config path is safe: ${NIX_LAYER7_APP_CONFIG_DIR}"
  else
    fail_check "Layer 7 app config path outside allowed experiment roots: ${NIX_LAYER7_APP_CONFIG_DIR}"
  fi
  if layer7_path_safe "${NIX_LAYER7_APP_CACHE_DIR}"; then
    ok "Layer 7 app cache path is safe: ${NIX_LAYER7_APP_CACHE_DIR}"
  else
    fail_check "Layer 7 app cache path outside allowed experiment roots: ${NIX_LAYER7_APP_CACHE_DIR}"
  fi

  if app_bin=$(layer7_resolved_app_binary); then
    real=$(canonical_path "${app_bin}")
    ok "Layer 7 app binary found: ${app_bin} -> ${real}"
    if layer7_binary_is_nix_backed "${app_bin}"; then
      ok "Layer 7 app binary origin is Nix profile/store"
      if [ "${layer7_active}" -eq 1 ] && layer7_path_safe "${NIX_LAYER7_APP_STATE_DIR}" && layer7_path_safe "${NIX_LAYER7_APP_CONFIG_DIR}" && layer7_path_safe "${NIX_LAYER7_APP_CACHE_DIR}"; then
        ok "Layer 7 ready: launcher active with Nix-backed app binary"
      fi
    else
      if [ "${layer7_active}" -eq 1 ]; then
        fail_check "Layer 7 app binary origin is unsafe/non-Nix: ${app_bin} -> ${real}"
      else
        warn "Layer 7 app binary origin is unsafe/non-Nix: ${app_bin} -> ${real}"
      fi
    fi
  else
    if [ "${layer7_active}" -eq 1 ]; then
      warn "Layer 7 app binary missing: ${NIX_LAYER7_APP_BIN}; install with standard nix profile first"
    else
      ok "Layer 7 app binary missing while inactive: ${NIX_LAYER7_APP_BIN}"
    fi
  fi
}

check_layer8() {
  state=$(layer8_state)
  eligibility=$(layer8_eligibility)

  case "${state}" in
    inactive|absent)
      ok "Layer 8 daemon state: inactive"
      ;;
    active|enabled|running)
      ok "Layer 8 daemon state: ${state}"
      ;;
    partial|failed)
      fail_check "Layer 8 daemon state is ${state}; run nixctl daemon rollback/disable or inspect ${NIX_LAYER8_STATE_DIR}"
      ;;
    rejected)
      warn "Layer 8 daemon state is rejected; keep using Layer 4-7 fallback"
      ;;
    *)
      warn "Layer 8 daemon state has unexpected value: ${state}"
      ;;
  esac

  case "${eligibility}" in
    available:*)
      ok "Layer 8 daemon eligibility: ${eligibility}"
      ;;
    unsupported:*)
      if [ "${state}" = "active" ] || [ "${state}" = "enabled" ] || [ "${state}" = "running" ]; then
        fail_check "Layer 8 daemon active but prerequisites are missing: ${eligibility}"
      else
        warn "Layer 8 daemon eligibility: ${eligibility}"
      fi
      ;;
    *)
      warn "Layer 8 daemon eligibility: ${eligibility}"
      ;;
  esac

  if socket_unit=$(systemd_unit_path "${NIX_DAEMON_SOCKET}" 2>/dev/null); then
    ok "Layer 8 socket unit present: ${socket_unit}"
  else
    if [ "${state}" = "active" ] || [ "${state}" = "enabled" ] || [ "${state}" = "running" ]; then
      fail_check "Layer 8 active state missing socket unit: ${NIX_DAEMON_SOCKET}"
    else
      ok "Layer 8 socket unit inactive/missing: ${NIX_DAEMON_SOCKET}"
    fi
  fi

  if service_unit=$(systemd_unit_path "${NIX_DAEMON_SERVICE}" 2>/dev/null); then
    ok "Layer 8 service unit present: ${service_unit}"
  else
    if [ "${state}" = "active" ] || [ "${state}" = "enabled" ] || [ "${state}" = "running" ]; then
      fail_check "Layer 8 active state missing service unit: ${NIX_DAEMON_SERVICE}"
    else
      ok "Layer 8 service unit inactive/missing: ${NIX_DAEMON_SERVICE}"
    fi
  fi

  build_group=$(layer8_build_users_group)
  case "${build_group}" in
    "")
      warn "Layer 8 build-users-group is empty; this is expected for Layer 4 single-user/root fallback but not daemon mode"
      ;;
    "(no nix.conf)")
      warn "Layer 8 daemon config unavailable: ${NIX_USER_CONFIG_FILE} missing"
      ;;
    "(default)")
      if group_exists nixbld; then
        ok "Layer 8 build-users-group defaults to existing nixbld group"
      else
        warn "Layer 8 build-users-group defaults to nixbld, but nixbld group is missing"
      fi
      ;;
    *)
      if group_exists "${build_group}"; then
        ok "Layer 8 build-users-group exists: ${build_group}"
      else
        warn "Layer 8 build-users-group missing from ${NIX_GROUP_FILE}: ${build_group}"
      fi
      ;;
  esac

  if [ -S "${NIX_DAEMON_SOCKET_PATH}" ]; then
    ok "Layer 8 daemon socket exists: ${NIX_DAEMON_SOCKET_PATH}"
  else
    if [ "${state}" = "running" ]; then
      fail_check "Layer 8 running state missing daemon socket: ${NIX_DAEMON_SOCKET_PATH}"
    else
      ok "Layer 8 daemon socket not present while inactive/not running: ${NIX_DAEMON_SOCKET_PATH}"
    fi
  fi

  ok "Layer 8 fallback: Layer 4 single-user/root Nix remains the primary recovery path"
}

check_network() {
  if [ "${CHECK_NETWORK}" -eq 0 ]; then
    warn "network checks skipped"
    return
  fi

  if have curl; then
    if curl -fsSI --connect-timeout 10 https://cache.nixos.org >/dev/null 2>&1; then
      ok "can reach https://cache.nixos.org"
    else
      fail_check "cannot reach https://cache.nixos.org"
    fi
  elif have wget; then
    if wget --spider -T 10 https://cache.nixos.org >/dev/null 2>&1; then
      ok "can reach https://cache.nixos.org"
    else
      fail_check "cannot reach https://cache.nixos.org"
    fi
  else
    fail_check "curl or wget is required for network checks and first install"
  fi
}

check_architecture
check_root_model
check_storage
check_artifact
check_wrappers
check_runtime
check_dev_shell
check_network
check_layer3_mount
check_layer4
check_layer5
check_layer6
check_layer7
check_layer8

if [ "${FAILURES}" -eq 0 ]; then
  echo "nix-doctor: passed with ${WARNINGS} warning(s)"
  exit 0
fi

echo "nix-doctor: failed with ${FAILURES} failure(s) and ${WARNINGS} warning(s)"
exit 1
