#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
#
# Layer 14 ExecStopPost helper for rocknix-guest-v2.service.
#
# Reclaim contract: when the guest exits unexpectedly under THIN_HOST=yes,
# bring up the host's installed-but-not-running fallback userland so the
# device stays usable until the next boot. Under THIN_HOST=no this is a
# no-op (host services are already running), but the script still runs
# so the path is exercised in soak.
#
# Distinguishes graceful from crash exits via systemd ExecStopPost env
# vars ($EXIT_CODE / $EXIT_STATUS / $SERVICE_RESULT). Reference:
# systemd.exec(5) "Environment Variables in Spawned Processes".
#
# Logs to journal (StandardOutput=journal in unit) and to a tagged
# file at /var/log/rocknix-host-reclaim.log so post-incident review
# survives journal rotation.

set -u

LOG_FILE="/var/log/rocknix-host-reclaim.log"
HOST_SERVICES="sway essway pipewire.socket pipewire-pulse.socket wireplumber bluetooth inputplumber"

ts() {
  date -u +%FT%TZ
}

log() {
  msg="$(ts) rocknix-host-reclaim: $*"
  printf '%s\n' "${msg}"
  printf '%s\n' "${msg}" >> "${LOG_FILE}" 2>/dev/null || true
}

# systemd populates these in ExecStopPost when available.
EXIT_CODE="${EXIT_CODE:-}"
EXIT_STATUS="${EXIT_STATUS:-}"
SERVICE_RESULT="${SERVICE_RESULT:-}"

log "stop-post fired: SERVICE_RESULT=${SERVICE_RESULT} EXIT_CODE=${EXIT_CODE} EXIT_STATUS=${EXIT_STATUS}"

# Decide whether this is a graceful exit or a crash. Graceful cases:
#   SERVICE_RESULT=success         (clean stop)
#   SERVICE_RESULT=killed AND admin-requested kill (SIGTERM/SIGINT/SIGHUP)
# Crash cases (auto-reclaim):
#   SERVICE_RESULT=core-dump | watchdog | timeout | resources | protocol
#   SERVICE_RESULT=exit-code with non-zero EXIT_STATUS
#   SERVICE_RESULT=killed with SIGKILL/SIGABRT/SIGSEGV
case "${SERVICE_RESULT}" in
  success)
    log "graceful stop; reclaim skipped"
    exit 0
    ;;
  killed)
    case "${EXIT_STATUS}" in
      TERM|HUP|INT|QUIT)
        log "admin-signaled stop (${EXIT_STATUS}); reclaim skipped"
        exit 0
        ;;
      *)
        log "guest killed by ${EXIT_STATUS}; engaging reclaim"
        ;;
    esac
    ;;
  exit-code)
    if [ "${EXIT_CODE}" = "exited" ] && [ "${EXIT_STATUS}" = "0" ]; then
      log "guest exited cleanly; reclaim skipped"
      exit 0
    fi
    log "guest exited non-zero (${EXIT_STATUS}); engaging reclaim"
    ;;
  core-dump|watchdog|timeout|resources|protocol|start-limit-hit)
    log "guest failed with ${SERVICE_RESULT}; engaging reclaim"
    ;;
  '')
    log "no SERVICE_RESULT provided (manual invocation); engaging reclaim"
    ;;
  *)
    log "unknown SERVICE_RESULT=${SERVICE_RESULT}; engaging reclaim defensively"
    ;;
esac

log "starting host fallback services: ${HOST_SERVICES}"

# Best-effort: a missing service (e.g. host stripped further in a future
# build) should not block the rest. Log the outcome of each.
for svc in ${HOST_SERVICES}; do
  if systemctl list-unit-files "${svc}" >/dev/null 2>&1; then
    if systemctl start "${svc}" 2>/dev/null; then
      log "  start ${svc}: ok"
    else
      log "  start ${svc}: FAILED ($(systemctl is-active "${svc}" 2>/dev/null))"
    fi
  else
    log "  start ${svc}: SKIPPED (unit not installed)"
  fi
done

log "reclaim complete"
exit 0
