# SM8550 guest: Nix main-space guest unit (v2).
#
# This unit replaces the experimental broad-bind unit that lived at
# /storage/.config/system.d/rocknix-guest.service during the Tier A-E
# spike series. The shopping list applied here is the direct lesson
# of those spikes:
#
#   - NO host /usr leak  -> drop --bind-ro=/usr (Vulkan/EGL ICD pollution,
#                           Mesa store-path mismatch)
#   - NO host /lib leak  -> drop --bind-ro=/lib  (same class of pollution)
#   - NO /etc/profile leak -> drop --bind-ro=/etc/profile{,/.d}
#                             (PATH clobber from 098-busybox)
#   - NO /etc/resolv.conf bind -> guest owns its own resolv.conf
#                                 (host resolvconf was clobbering guest DNS)
#   - NO /run/0-runtime-dir bind -> guest runs its own wayland compositor
#   - NO /tmp/.X11-unix bind     -> guest does not need host X11
#   - NO /etc/ssh/authorized_keys.d bind -> guest SSH, when enabled in
#                                           the guest, owns its own keys
#   - NO blanket /storage bind   -> only narrow subdirs (roms RO, guest area RW)
#
# Network:
#   --register=no  -> avoid host machinectl coupling
#   no --private-network -> shared host netns; guest's NetworkManager owns
#                           wlan0 directly (Tier C finding)
#
# Lifecycle:
#   ExecStartPre seeds /run/current-system + /run/booted-system from
#     /nix/var/nix/profiles/system (Tier E3 finding: /run is tmpfs and
#     does not persist across cold boot)
#   ExecStopPost runs reclaim contract: if guest exited unexpectedly,
#     restart host fallback userland so the device stays usable until the
#     next boot.
#
# This unit is enabled on SM8550 via Wants= on rocknix-graphical.target.

[Unit]
Description=ROCKNIX SM8550 guest (Nix main-space, v2)
Documentation=file:///usr/lib/nix-integration/docs/layer14-main-space-contract.md
RequiresMountsFor=/storage /nix
After=local-fs.target nix.mount network-pre.target rocknix-automount.service
Requires=nix.mount
ConditionPathExists=/storage/machines/rocknix-guest
ConditionPathExists=/usr/bin/systemd-nspawn

[Service]
Type=notify
NotifyAccess=all
KillMode=mixed
Delegate=yes
TasksMax=4096

# Force unified cgroup hierarchy inside the guest container. The host
# kernel cmdline sets systemd.unified_cgroup_hierarchy=1, but
# systemd-nspawn from systemd-255 (host) still mounts a cgroup-v1 view
# inside the container by default for legacy compat. The guest's
# systemd-258 refuses to run on legacy v1 hierarchy and aborts with
# "Detected unsupported legacy cgroup hierarchy, refusing execution."
#
# Validated on Thor 2026-05-08: without this env, the guest aborts
# at PID 1; with it, the guest reaches Multi-User System target.
Environment=SYSTEMD_NSPAWN_UNIFIED_HIERARCHY=1

# Bound the guest so host recovery remains responsive.
CPUWeight=100
IOWeight=100
MemoryMax=6G

WorkingDirectory=/storage/machines/rocknix-guest

# Seed /run/current-system + /run/booted-system; touch the resolv.conf
# ownership marker; verify the rootfs is shaped for SM8550 guest.
ExecStartPre=/usr/bin/rocknix-guest-prep

# Stage a scrubbed copy of /run/udev under /run/.guest-udev. libseat
# walks the kernel udev DB during DRM session bring-up; if it finds an
# entry for a device InputPlumber has already hot-removed (the AYN
# gamepad source on event3) it aborts and cascades into a wlroots GPU
# reset. The stage script removes any data file tagged
# `inputplumber/by-hidden` from a private copy. The bind below then
# replaces the guest's /run/udev with the cleaned tree.
ExecStartPre=/usr/bin/rocknix-guest-udev-stage

ExecStart=/usr/bin/systemd-nspawn \
  --machine=rocknix-guest \
  --directory=/storage/machines/rocknix-guest \
  --boot \
  --register=no \
  --keep-unit \
  --bind=/dev/snd \
  --bind=/dev/rfkill \
  --bind=/dev/dri/card0 \
  --bind=/dev/dri/renderD128 \
  --bind=/dev/input \
  --bind=/dev/tty0 \
  --bind=/dev/tty1 \
  --bind-ro=/run/.guest-udev:/run/udev \
  --bind=/sys/class/backlight \
  --bind=/sys/class/leds \
  --bind=/sys/class/devfreq \
  --bind=/sys/devices/system/cpu/cpufreq \
  --bind-ro=/storage/roms \
  --bind=/storage/roms/bios:/storage/roms/bios \
  --bind=/storage/.config/Cemu:/storage/.config/Cemu \
  --bind=/storage/.config/MangoHud:/storage/.config/MangoHud \
  --bind=/storage/.local:/storage/.local \
  --bind=/storage/.guest

# When systemd-nspawn exits, hand off to reclaim. Reclaim distinguishes
# graceful from crash exits via $EXIT_CODE / $EXIT_STATUS.
ExecStopPost=/usr/bin/rocknix-host-reclaim

Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=30s
WatchdogSec=30s

StandardOutput=journal
StandardError=journal

[Install]
# Intentionally NOT WantedBy=multi-user.target; this unit is owned by the
# SM8550 main-space target instead.
WantedBy=rocknix-graphical.target
