#
# Per-boot recovery override.
#
# This oneshot runs before sysinit.target and selects the boot's
# default.target based on two toggles (OR semantics):
#   1) /flash/rocknix.no-nspawn flag file (sticky -- survives reboots
#      until manually rm'd; clearable from a card reader on another
#      machine without booting Thor)
#   2) rocknix.safe=1 on the kernel cmdline (per-boot only; clearable
#      by a normal reboot without touching /flash)
#
# Either toggle present -> boot to rocknix.target (ROCKNIX recovery
# plane). Both absent -> boot to rocknix-graphical.target (Nix guest
# main-space).

[Unit]
Description=ROCKNIX recovery override (selects default.target per boot)
Documentation=file:///flash/HOW-TO-FALL-BACK.md
DefaultDependencies=no
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

# Run on every boot. The conditions inside the script decide the action;
# we cannot use ConditionPathExists here because we want to run when the
# flag is ABSENT too (to flip back to rocknix-graphical.target after a
# user rm'd the flag).

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/rocknix-recovery-toggle
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=sysinit.target
