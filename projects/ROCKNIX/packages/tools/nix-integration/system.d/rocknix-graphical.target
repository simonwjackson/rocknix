#
# Main-space target. This is default.target on SM8550 builds. It Wants
# the guest unit and does NOT Want the legacy host
# sway/essway/pipewire/wireplumber/bluetooth/inputplumber stack -- those
# stay installed but un-Wanted, ready for the recovery path or reclaim
# contract to bring them up.

[Unit]
Description=ROCKNIX Nix main-space (SM8550 guest)
Documentation=file:///usr/lib/nix-integration/docs/layer14-main-space-contract.md
Requires=multi-user.target rocknix-automount.service nix.mount
After=multi-user.target rocknix-automount.service nix.mount network-online.target
Wants=rocknix-guest-v2.service
AllowIsolate=yes

[Install]
Alias=default.target
