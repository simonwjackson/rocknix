[Unit]
Description=Nix daemon socket (experimental ROCKNIX Layer 8)
Documentation=https://nix.dev/manual/nix/latest/installation
Requires=nix.mount
After=nix.mount
ConditionPathIsMountPoint=/nix

[Socket]
ListenStream=/nix/var/nix/daemon-socket/socket
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
