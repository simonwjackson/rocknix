[Unit]
Description=Prepare storage-backed Nix directory
After=local-fs.target userconfig.service
Wants=userconfig.service
RequiresMountsFor=/storage
Before=nix.mount

[Service]
Type=oneshot
ExecStart=/bin/mkdir -p /storage/.nix-root/store /storage/.nix-root/var/nix
ExecStart=/bin/chmod 0755 /storage/.nix-root /storage/.nix-root/store /storage/.nix-root/var /storage/.nix-root/var/nix
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
