#!/bin/sh
# ROCKNIX Nix Layer 7 browser experiment launcher.

set -u

APP_NAME="${ROCKNIX_LAYER7_BROWSER_APP:-chromium}"
STATE_DIR="${ROCKNIX_LAYER7_BROWSER_STATE_DIR:-${HOME:-/storage}/.local/share/nix-apps/layer7/browser}"
CONFIG_DIR="${ROCKNIX_LAYER7_BROWSER_CONFIG_DIR:-${HOME:-/storage}/.config/nix-apps/layer7/browser}"
CACHE_DIR="${ROCKNIX_LAYER7_BROWSER_CACHE_DIR:-${HOME:-/storage}/.cache/nix-apps/layer7/browser}"
APP_BIN_PATH="${ROCKNIX_LAYER7_BROWSER_BIN_PATH:-}"
EXTRA_ARGS="${ROCKNIX_LAYER7_BROWSER_EXTRA_ARGS:-about:blank}"

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

canonical_path() {
  path=$1
  if [ -e "${path}" ] || [ -L "${path}" ]; then
    readlink -f "${path}" 2>/dev/null || echo "${path}"
  else
    echo "${path}"
  fi
}

profile_bin_dir() {
  echo "${HOME:-/storage}/.nix-profile/bin"
}

resolve_app_binary() {
  if [ -n "${APP_BIN_PATH}" ]; then
    [ -x "${APP_BIN_PATH}" ] || fail "configured app binary is missing or not executable: ${APP_BIN_PATH}"
    echo "${APP_BIN_PATH}"
    return 0
  fi

  profile_candidate="$(profile_bin_dir)/${APP_NAME}"
  if [ -x "${profile_candidate}" ]; then
    echo "${profile_candidate}"
    return 0
  fi

  if have "${APP_NAME}"; then
    command -v "${APP_NAME}"
    return 0
  fi

  fail "Layer 7 app binary '${APP_NAME}' not found; install it with standard 'nix profile install' first"
}

is_nix_backed_binary() {
  candidate=$1
  real=$(canonical_path "${candidate}")
  case "${candidate}" in
    "$(profile_bin_dir)"/*) return 0 ;;
  esac

  # Build store prefixes without embedding literal store paths in this file.
  # Layer 6 doctor scans activated files for concrete store references and
  # would otherwise treat shell pattern text as a missing store path.
  default_store_prefix="${NIX_INSTALL_ROOT:-/nix}/store/"
  storage_store_prefix="/storage/.nix-root/store/"
  case "${real}" in
    "${default_store_prefix}"*|"${storage_store_prefix}"*) return 0 ;;
  esac
  return 1
}

safe_layer7_dir() {
  case "$1" in
    "${HOME:-/storage}/.local/share/nix-apps/layer7/"*|"${HOME:-/storage}/.config/nix-apps/layer7/"*|"${HOME:-/storage}/.cache/nix-apps/layer7/"*|/storage/.local/share/nix-apps/layer7/*|/storage/.config/nix-apps/layer7/*|/storage/.cache/nix-apps/layer7/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

check_layer7_dirs() {
  safe_layer7_dir "${STATE_DIR}" || fail "Layer 7 app state path is outside allowed experiment roots: ${STATE_DIR}"
  safe_layer7_dir "${CONFIG_DIR}" || fail "Layer 7 app config path is outside allowed experiment roots: ${CONFIG_DIR}"
  safe_layer7_dir "${CACHE_DIR}" || fail "Layer 7 app cache path is outside allowed experiment roots: ${CACHE_DIR}"
}

check_ready() {
  app_path=$(resolve_app_binary)
  if ! is_nix_backed_binary "${app_path}"; then
    fail "Layer 7 app binary is not Nix-backed: ${app_path} -> $(canonical_path "${app_path}")"
  fi
  check_layer7_dirs
  echo "rocknix-layer7-browser:ready app=${APP_NAME} binary=${app_path} real=$(canonical_path "${app_path}") state=${STATE_DIR} config=${CONFIG_DIR} cache=${CACHE_DIR}"
}

find_sway_socket() {
  if [ -n "${SWAYSOCK:-}" ] && [ -S "${SWAYSOCK}" ]; then
    echo "${SWAYSOCK}"
    return 0
  fi
  for socket in /var/run/0-runtime-dir/sway-ipc.*.sock; do
    [ -S "${socket}" ] || continue
    echo "${socket}"
    return 0
  done
  return 1
}

launch_app() {
  app_path=$(resolve_app_binary)
  if ! is_nix_backed_binary "${app_path}"; then
    fail "Layer 7 app binary is not Nix-backed: ${app_path} -> $(canonical_path "${app_path}")"
  fi
  check_layer7_dirs

  mkdir -p "${STATE_DIR}" "${CONFIG_DIR}" "${CACHE_DIR}" || fail "cannot create Layer 7 app dirs"

  export CHROME_CONFIG_HOME="${CONFIG_DIR}"
  export XDG_CONFIG_HOME="${CONFIG_DIR}"
  export XDG_CACHE_HOME="${CACHE_DIR}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}"
  export DISPLAY="${DISPLAY:-:0.0}"
  export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

  app_cmd="CHROME_CONFIG_HOME=${CONFIG_DIR} XDG_CONFIG_HOME=${CONFIG_DIR} XDG_CACHE_HOME=${CACHE_DIR} ${app_path} --user-data-dir=${STATE_DIR} --no-first-run --disable-sync --no-sandbox --ozone-platform=wayland ${EXTRA_ARGS}"

  if sway_socket=$(find_sway_socket); then
    export SWAYSOCK="${sway_socket}"
    if have swaymsg; then
      exec swaymsg -s "${SWAYSOCK}" exec "${app_cmd}"
    fi
  fi

  if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    # shellcheck disable=SC2086 # EXTRA_ARGS is intentionally split for launcher flags.
    exec "${app_path}" --user-data-dir="${STATE_DIR}" --no-first-run --disable-sync --no-sandbox --ozone-platform=wayland ${EXTRA_ARGS}
  fi

  fail "no active Sway/display context found for Layer 7 app launch"
}

case "${1:-launch}" in
  --check|check|status)
    check_ready
    ;;
  --print-env|env)
    echo "ROCKNIX_LAYER7_BROWSER_APP=${APP_NAME}"
    echo "ROCKNIX_LAYER7_BROWSER_STATE_DIR=${STATE_DIR}"
    echo "ROCKNIX_LAYER7_BROWSER_CONFIG_DIR=${CONFIG_DIR}"
    echo "ROCKNIX_LAYER7_BROWSER_CACHE_DIR=${CACHE_DIR}"
    ;;
  --launch|launch)
    launch_app
    ;;
  -h|--help|help)
    cat <<EOF
Usage: ${0##*/} [--check|--print-env|--launch]

Layer 7 browser experiment launcher. Install the selected app with standard
'nix profile install' first, then activate this launcher through Layer 6.
EOF
    ;;
  *)
    fail "unknown argument: $1"
    ;;
esac
