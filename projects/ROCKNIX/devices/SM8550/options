################################################################################
# setup device defaults
################################################################################

  # The TARGET_CPU variable controls which processor should be targeted for
  # generated code.
    case ${TARGET_ARCH} in
      aarch64)
        TARGET_KERNEL_ARCH="arm64"
        TARGET_KERNEL_PATCH_ARCH="aarch64"
        TARGET_CPU="cortex-x3"
        TARGET_ARCH_FLAGS="+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve"
        TARGET_FEATURES="64bit"
        ;;
      arm)
        TARGET_KERNEL_ARCH="arm64"
        TARGET_KERNEL_PATCH_ARCH="aarch64"
        TARGET_CPU="cortex-a710"
        TARGET_ARCH_FLAGS="+fp16+crypto+i8mm+bf16"
        TARGET_TUNE_FLAGS="+crypto"
        TARGET_FPU="crypto-neon-fp-armv8"
        TARGET_FLOAT="hard"
        TARGET_FEATURES="32bit"
        ;;
    esac

    PARTITION_TABLE="gpt"
    HW_CPU="Snapdragon 8 Gen2"

  # Kernel target
    KERNEL_TARGET="Image"

  # Additional kernel make parameters (for example to specify the u-boot loadaddress)
    KERNEL_MAKE_EXTRACMD=" $(get_kernel_make_extracmd)"

  # Kernel cmdline
    EXTRA_CMDLINE="quiet rootwait console=tty0 allow_mismatched_32bit_el0 fw_devlink.strict=1 pcie_ports=compat irqaffinity=0-2 systemd.unified_cgroup_hierarchy=1 systemd.legacy_systemd_cgroup_controller=0 nosoftlockup usbcore.interrupt_interval_override=045e:028e:2"

  # Layer 10b NixOS guests require systemd-nspawn to present cgroup v2.
    SYSTEMD_DEFAULT_HIERARCHY="unified"

  # Bootloader to use (syslinux / u-boot)
    BOOTLOADER="qcom-abl"

  # Adreno GPU family
    GRAPHIC_DRIVERS="freedreno"

  # For maximum cross compatbility
    PREFER_GLES="no"

  # Experimental thin-host switch for the SM8550 Nix main-space build.
  # When enabled, ROCKNIX keeps the boot/update/recovery/container substrate
  # and lets the NixOS guest own the product UX. The image package uses this
  # knob to skip host UI, emulators, multimedia, 32-bit runtime, demos, and
  # other user-facing payloads.
    SM8550_MINIMAL_HOST="${SM8550_MINIMAL_HOST:-yes}"

  # VULKAN_SUPPORT
    VULKAN_SUPPORT="yes"

  # Vulkan implementation to use (vulkan-loader / no)
    VULKAN="vulkan-loader"

  # Displayserver to use (wl / no)
    DISPLAYSERVER="wl"

  # Windowmanager to use (weston / swaywm-env / no)
    WINDOWMANAGER="swaywm-env"

    if [ "${SM8550_MINIMAL_HOST}" = "yes" ]; then
      VULKAN_SUPPORT="no"
      VULKAN="no"
      DISPLAYSERVER="no"
      WINDOWMANAGER="none"
      EMULATION_DEVICE="no"
      PIPEWIRE_SUPPORT="no"
      BLUETOOTH_SUPPORT="no"
      AVAHI_DAEMON="no"
      REMOTE_SUPPORT="no"
      JOYSTICK_SUPPORT="no"
      MODULES_PKG="no"
      DEBUG_PACKAGES="no"
      NFS_SUPPORT="no"
      SAMBA_SERVER="no"
      SFTP_SERVER="no"
      SIMPLE_HTTP_SERVER="no"
      ZEROTIER_SUPPORT="no"
      WIREGUARD_SUPPORT="no"
      NANO_EDITOR="no"
      HTOP_TOOL="no"
      BTOP_TOOL="no"
    fi

  # Additional drivers to install:
  # for a list of additional drivers see packages/linux-drivers
  # Space separated list is supported,
  # e.g. ADDITIONAL_DRIVERS="DRIVER1 DRIVER2"
    ADDITIONAL_DRIVERS=""

  # Additional Firmware to use ( )
  # Space separated list is supported,
  # e.g. FIRMWARE=""
    FIRMWARE=""

  # Additional packages to install. The minimal host keeps only the bootloader
  # payload and InputPlumber because the guest compositor consumes the staged
  # input device view from the host.
    if [ "${SM8550_MINIMAL_HOST}" = "yes" ]; then
      ADDITIONAL_PACKAGES="rocknix-abl inputplumber"
    else
      ADDITIONAL_PACKAGES="gamepadcalibration screen-switch rocknix-abl inputplumber"
    fi

  # Debug tty path
    DEBUG_TTY="/dev/ttyMSM0"

  # Build and install rocknix joypad driver (yes / no)
    ROCKNIX_JOYPAD="no"

  # ZRAM Algorithm
    ZRAM_COMPRESSION_ALGO="zstd"

  # ZRAM Size
    ZRAM_SWAP_SIZE="Auto"

  # Disk Swap
    SWAP_FILE_SIZE="0"
